<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig.dtd">
<policyconfig>
  <vendor>MBU GUI</vendor>
  <vendor_url>https://linuxbackupsoftware.org</vendor_url>
  <action id="org.linuxbackupsoftware.mbu-gui.helper">
    <description>Run MBU disk backup operations</description>
    <message>MBU needs administrator permission to copy disks and fix boot files</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mbu-gui/mbu-gui-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
