##############################################################################
# mbuFormatTableWrite [<opt>]...  -- generate an MBU disk format table
#       See help message below for options.
# On success, output filepath is returned via qresult.
##############################################################################
mbuFormatTabletWriteHelp='
Creates a partition table file for later use with mbuFormat.
You can modify the partition table file before using it, if you desire.

This is part of the MBU backup system, but it may work even if your
disk partitions are not named in an MBU compatible way.
In the case of incompatible partition names, the entire partition name
will be emitted as the "function" part (see MBU docs).

OPTIONS are:
help | -help | --help -- print help for this message (only).
-d -- turn on all debug messages
-o <outfile>  -- specify filepath of created backup script 
            Default is $mbuOutDir/mbuformat.custom
-frompset <set> -- based on all partitions of a partition set
            Default is the partition set to which belongs
            the partition holding the running linux root filesystem (/).
            Note that the output file is independent of any 
            specific partition set or partitions.
    <set> is a partition set name in use on the system, or
        a partition name in use of the system,
        anything acceptable to mbuDevFind so long as it can resolve
        to a partition hame.
        If a partition name is passed this way, it is replaced by
        the partition set component of the partition name.

The most likely modification you may want to make to the generated table
is to modify the the partition sizes.
'  # END mbuFormatTabletWriteHelp ... beware of quote marks!
# TODO ? maybe add filter argument, using mlu
mbuFormatTableWrite()
{
    qEnter "$@"  # our standard way to begin a function
    mbuDevRefreshMaybe
    # We use some mbu global variables to implement some options:
    local qbug=$qbug    # "local" to shield our changes from parent
    local quser=$quser  # "local" to shield our changes from parent
    local datestamp=$(date +%Y/%m/%d-%H:%M:%S)     # for diagnostics
    local outfile="$mbuOutDir/mbuformat.table"   # default
    local pset=''    # partition set to base table on
    local basedisk=''   # disk device we based pset on

    while true ; do
        local option="${1:-}" ; shift||true
        case "$option" in
            '') break
            ;;
            -d)         # turn on debugs
                qbug=y
                quser=y
            ;;
            help|-help|--help) 
                echo "$mbuFormatTabletWriteHelp" ; 
                echo "$mbuFormatTableHelp" ;
                return 0; 
            ;;
            -o) outfile="${1:-}" ; shift||true
                if test -z "$outfile" ; then 
                    qReturnFail "-o needs arg"  ; return 1 ; fi
            ;;
            -frompset) 
                local basespec="${1:-}"; shift||true
                pset=''   # not found yet
                if test -z "$basespec" ; then 
                    qReturnFail "-frompset needs arg"  ; return 1 
                fi
                case "$basespec" in
                    *=* )       # must be an mbuDevFind spec
                        if mbuDevFind match=unique "$basespec" ; then
                            qReturnFail "Part. set not identified from: $basespec" 
                            return 1
                        fi
                        local pdevname ; qResult pdevname
                        pset="${mbuDevP_partset[$pdevname]}"
                        basedisk="${mbuDevP_parentname[$pdevname]}"
                        if test -z "$basedisk" ; then
                            qReturnFail "Not a partition device: $pdevname" ; return 1
                        fi
                        continue
                    ;;
                esac
                # might be a partition set name
                if ! mbuDevFind "partset=$basespec" ; then
                    qReturnFail ; return 1
                fi
                local pdevnames ; qResult pdevnames   # are there any?
                if ! test -z "$pdevnames" ; then # there are some!
                    pset="$basespec"    # this must be a pset!
                    basedisk=''   # no particular base disk
                    continue
                fi
                # might be a partition name
                if ! mbuDevFind match=nonmultiple "partname=$basespec" ; then
                    qReturnFail ; return 1
                fi
                local pdevname ; qResult pdevname   # is there such a partition?
                if ! test -z "$pdevname" ; then # there are some!
                    pset="${mbuDevP_partset[$pdevname]}"
                    basedisk="${mbuDevP_parentname[$pdevname]}"
                    continue
                fi
                qReturnFail "No match for $basespec" ; return 1
            ;;
            *) 
                qReturnFail "invalid option: $option" ; return 1
            ;;
        esac
    done

    # Use default partition set if not specified
    if test -z "$pset" ; then
        if ! mbuDevFind / ; then
            qReturnFail  ; return 1   # shouldnt happen
        fi
        local pdevname ; qResult pdevname
        pset="${mbuDevP_partset[$pdevname]}"
        basedisk="${mbuDevP_parentname[$pdevname]}"
    fi
    if test -z "$pset" ; then
        qReturnFail ; return 1   # shouldnt happen
    fi

    # Find the list of partition devices sharing that partition set
    # Note that this list will be in canonical order.
    if ! mbuDevFind "partset=$pset" ; then
        qReturnFail ; return 1
    fi
    local inpdevs ; qResult inpdevs
    if test -z "$inpdevs" ; then
        qReturnFail ; return 1       #shouldnt happen
    fi

    # Convert this into a list of disk devices without losing order
    # The 0th element is unused, to simplify 1-based addressing (dnum).
    # If basedisk was found we put it first. 
    local -a disklist=( ZERO_UNUSED $basedisk )
    local pdevname
    for pdevname in $inpdevs ; do
        local disk=${mbuDevP_parentname[$pdevname]}
        if test -z "$disk" ; then qReturnFail; return 1; fi #shouldnt happen
        local idisk
        local newdisk=''
        for idisk in ${!disklist[@]} ; do
            if test "$idisk" = 0 ; then continue; fi    # don't use disklist[0]
            local thisdisk=${disklist[$idisk]}
            if test "$thisdisk" = "$disk" ; then
                continue 2      # already in list; on to next device
            fi
        done
        disklist+=( "$disk" )      # add to list of disks used
    done
    qbug "Found list of disks: ${disklist[*]}"

    # Convert this into a list of partition devices,
    if ! mbuDevFind "partset=$pset" ; then
        qReturnFail ; return 1                # shoulndt happen
    fi
    local pdevs ; qResult pdevs
    qbug "Before sorting, pdevs=$pdevs"
    if test -z "$pdevs" ; then
        qReturnFail ; return 1        # shouldnt happen
    fi
    # Now ordered canonical within disk, but with disk order as above
    local -a pdevlist=( )     # list of partition devices
    local -a pdnumist=( )     # list of disk numbers per pdev
    local -a ppnumist=( )     # list of part numbers per pdev
    local idisk
    for idisk in ${!disklist[@]} ; do
        if test "$idisk" = 0 ; then continue; fi  # don't use disklist[0]
        # TODO %%% double check this logic
        local -a dpdevlist; local -a pdevlist=( )     # list of partition devices
        local -a dpdnumlist; local -a pdnumist=( )     # list of disk numbers per pdev
        local -a dppnumlist; local -a ppnumist=( )     # list of part numbers per pdev
        local disk=${disklist[$idisk]}
        local pdevname
        for pdevname in $pdevs ; do
            local pnum=${mbuDevP_partnum[$pdevname]}
            dpdevlist[$pnum]="$pdevname"
            dpdnumlist[$pnum]="$idisk"
            dppnumlist[$pnum]="$pnum"
        done
        pdevlist+=( ${dpdevlist[@]} )
        pdnumlist+=( ${dpdnumlist[@]} )
        ppnumlist+=( ${dppnumlist[@]} )
    done
    qbug "After sorting:"
    qbug "pdevlist=${pdevlist[*]}"
    qbug "pdnumlist=${pdnumlist[*]}"
    qbug "ppnumlist=${ppnumlist[*]}"

    # Write output file
    if test -z "$basedisk" ; then
        quser "writing file: $outfile based on partition set $pset"
    else
        quser "writing file: $outfile based on partition set $pset and disk $basedisk"
    fi

    rm -f $outfile      # remove old one so permissions are appropriate
    mkdir -p $(dirname $outfile)  # create directory for it to live in as needed

    # Comments at the top of output file
    >$outfile  echo "########### MBU Disk Format Table #########"
    >>$outfile echo "#   Custom MBU formatting table generated at $datestamp"
    >>$outfile echo "#   Created from directory $mbuDir as: $outfile"
    >>$outfile echo "#   All partitions of partition set $pset were used"
    quser "All partitions of partition set $pset were used"
    if ! test -z "$basedisk" ; then
        >>$outfile echo "#   Partitions on disk $basedisk were put first"
        quser "Partitions on disk $basedisk were put first"
    fi
    >>$outfile echo "#   CAUTION: This script generated automatically and may be out of date!"
    # Add help message to output file  (description of file formatt)
    echo "$mbuFormatTableHelp" | sed -e 's/^/# /' >>$outfile
    # One more comment for the table:
    >>$outfile printf "%s %4s %4s %-12s %14s %s\n" '#--------' dnum pnum fnc psize ptype

    # Output the data table
    for ipdev in ${!pdevlist[@]} ; do
        local devname=${pdevlist[$ipdev]}       # partition device name, to look up properties
        local dnum=${pdnumlist[$ipdev]}         # order in our list of disk
        local pnum=${ppnumlist[$ipdev]}         # partition number of our partition device
        # or: local pnum=${mbuDevP_partnum[$devname]}
        local fnc=${mbuDevP_partfnc[$devname]}  # last part of the partition name
        local nbytes=${mbuDevP_size[$devname]}  # partition size
        local mb=$(expr $nbytes / 1024 / 1024)M   # convert to MB
        local type=${mbuDevP_parttype[$devname]}
        >>$outfile printf "%s %4s %4s %-12s %14s %s\n" 'PARTITION' $dnum $pnum $fnc $mb $type
    done

    >>$outfile echo "########### END MBU Disk Format Table #########"
    quser "Format table written -- look at $outfile"
    qReturnOk "$outfile"  ; return 0
}
##############################################################################
# mbuFormatDisk [<opt>]... 
#       Format entire disk based on data table
#       See help message below.
##############################################################################
mbuFormatDiskHelp='
This is part of the MBU backup system. 
It will format a disk or set of disks based on a partition table file.

Usage: mbuFormatDisk <ddev> <pset> <tablefile> [<opt>]...
Partitions are named with <pset> and partition functions from the table

OPTIONS <opt> are:

help | -help | --help -- print help for this message (only).
disk=<ddev> is the entire disk device file (not partition device file).
    Multiple such disks can be specified by concatenating them
    separted by commas (extraneous commas ignored).
    The disks in order given match the table file dnum 
    (disk number) fields (1, 2, etc.).
    The disks can be specified in any way that is acceptable to
    mbuDevFind.
pset=<pset> is the partition set name to use when generating partition
       names for the disk.
tablefile=<tablefile> is the name of the file containing the partition table.
tstring=<string> to pass the table directly as a string instead of via file
debug=y -- turn on all debug messages
fake=y -- do not actually format the disk, just show what would be done
        (Note: the given disk must meet all pre-requisites).
'  # END mbuFormatDiskHelp
# TODO be smarter about target disks that are too small etc
mbuFormatDisk()
{
    qEnter "$@"  # our standard way to begin a function
    mbuDevRefreshMaybe
    local qbug=$qbug    # "local" to shield our changes from parent
    local quser=$quser  # "local" to shield our changes from parent
    local datestamp=$(date +%Y/%m/%d-%H:%M:%S)     # for diagnostics
    local qbug="$qbug"   # so we can make temporary changes

    # Get options
    local options=''
    local dohelp=n ; options+='help:dohelp=y,-help:dohelp=y,--help:dohelp=y,'
    options+='debug:qbug,'      # can directly set qbug this way
    local fakeit=n ; options+='fake:fakeit,'
    local ddevspec=''  ; options+='disk:ddevspec,'
    local pset=''  ; options+='pset,'
    local tablefile='' ; options+='tablefile,'
    local tstring='' ; options+='tstring,'
    qOption "$options" "$@" ; shift $qresult
    if test $# -gt 0 ; then qReturnFail "Invalid args at: $*" ; return 1; fi

    # Help option
    if test "$dohelp" = y ; then
        echo "$mbuFormatDiskHelp" ; 
        echo "$mbuFormatTableHelp" ;
        qReturnOk ; return 0
    fi

    # Get the table
    local table=''              # content of table file
    if test -n "$tablefile" ; then
        if ! test -f "$tablefile" ; then
            qerror "No such file: $tablefile" ; return 1
        fi
        table=$(cat $tablefile)
    else
        table="$tstring"
    fi

    # Sanity checks
    if test -z "$ddevspec" ; then mbuReturnFail Need option disk=  ; return 1; fi
    if test -z "$table" ; then mbuReturnFail Need option tablefile=  ; return 1; fi
    if test -z "$pset" ; then mbuReturnFail Need option pset=  ; return 1; fi

    # Get and check entire disk device
    qSClean t=, v=ddevspec    # convert commas into spaces
    local -a ddevs=( ZERO_UNUSED $ddevspec )
    if test -z "${ddevs[1]:-}" ; then
        qReturnFail "missing disk device arg(s)"
        return 1
    fi
    # Sanity checks and clean up device specs
    local ddev
    local idisk
    for idisk in ${!ddevs[@]} ; do
        if test "$idisk" = 0 ; then continue ; fi  # first one is unused
        ddev=${ddevs[$idisk]}
        if ! mbuDevFind match=unique "$ddev" ; then 
            qReturnFail "Invalid: $ddev" ; return 1; 
        fi
        local devname ; qResult devname
        # Store the corrected name
        ddevs[$idisk]="$devname"
        # Now do sanity checcks
        local devpath=${mbuDevs[$devname]}
        if ! test -b "$devpath" ; then
            qReturnFail "invalid or missing device file: $devpath" ; return 1
        fi
        local devtype=${mbuDevP_devtype[$devname]}
        if ! test "$devtype" = disk ; then
            qReturnFail "Not a disk: $devname" ; return 1
        fi
        # Prevent even trying to format an active disk
        if ! mbuDevBusyCheck $devname ; then
            qReturnFail "Device $devname is busy." ; return 1
        fi
    done
    qbug "Disks: 1 ${ddevs[1]:-} 2 ${ddevs[2]:-} 3 ${ddevs[3]:-}"

    # Break table into lines. 
    local -a lines
    IFS=$'\n' read -r -d '' -a lines <<<"$table" || qbug "Ignoring bash read error $? here."

    # Make a pass through to see if sizes line up
    local idisk
    for idisk in ${!ddevs[@]} ; do
        if test "$idisk" = 0 ; then continue ; fi       # first element unused
        mbuDevRefreshMaybe       # ensure our info is up to date
        local ddev=${ddevs[$idisk]}
        local disksize="${mbuDevP_size[$ddev]}"
        qbug "AT disk $idisk $ddev SIZE $disksize"
        local psizesum=0        # sum of partition sizes for this disk
        local lineno
        for lineno in ${!lines[@]} ; do
            local line="${lines[$lineno]}"
            local key
            local dnum
            local pnum
            local fnc
            local psize
            local ptype
            <<<$line read -r key dnum pnum fnc psize ptype
            case "$key" in
                '') continue        # skip empty lines
                ;;
                '#'*) continue      # skip comments
                ;;
                PARTITION)  # good
                ;;
                *) # bad
                    qReturnFail "invalid table line: $line"
                    return 1
                ;;
            esac
            if test "$dnum" = 0 ; then
                qReturnFail "invalid disk number $dnum"
                return 1
            fi
            local thisddev=${ddevs[$dnum]}
            if test -z "$thisddev" ; then
                qReturnFail "no disk specified for disk number $dnum"
                return 1
            fi
            if ! test "$dnum" = "$idisk" ; then
                continue
            fi
            # Add up all the partition sizes
            case "$psize" in 
                *K) 
                    psize=${psize%?}    # strip the unit
                    psize=$((psize * 1024))
                ;;
                *M)
                    psize=${psize%?}    # strip the unit
                    psize=$((psize * 1024 * 1024))
                ;;
                *G)
                    psize=${psize%?}    # strip the unit
                    psize=$((psize * 1024 * 1024 * 1024))
                ;;
                *) true   # hope for the best
                ;;
            esac
            psizesum=$((psizesum + psize))
        done
        if test "$psizesum" = 0 ; then
            qReturnFail ; return 1 ; fi     # shouldnt happen
        # Error if too big ... gdisk fails badly.
        # Unfortunately this test doesn't allow for overhead of
        # the partition table etc.
        # So it might succeed when really it should fail.
        quser "AT disk $idisk $ddev SIZE $disksize bytes NEED $psizesum bytes"
        if test $psizesum -gt $disksize ; then
            qReturnFail "Partitions won't fit on disk $ddev" ; return 1
        fi
    done

    # Now to do the formatting. Possibly do multiple disks
    local idisk
    for idisk in ${!ddevs[@]} ; do
        if test "$idisk" = 0 ; then continue ; fi       # first element unused
        mbuDevRefreshMaybe       # ensure our info is up to date
        local ddev=${ddevs[$idisk]}
        quser "FORMATTING disk $idisk $ddev"
        # NOTE that mbuFormatWipe ensures device is NOT busy
        if ! mbuFormatWipe ask=n "$ddev" ; then
            qReturnFail "Cannot wipe disk $ddev" ; return 1
        fi
        mbuDevRefreshMaybe       # ensure our info is up to date
        # Compose the input for gdisk
        local gdiskfile="$mbuOutDir/mbu.gdisk"
        quser "Writing temp file $gdiskfile"
        qrun rm -f "$gdiskfile"
        qrun mkdir -p $(dirname $gdiskfile)  # create directory for it to live in as needed
        >$gdiskfile echo o           # Create new partition table
        >>$gdiskfile echo y           # yes to proceed
        local lineno
        local gdiskweird=y
        for lineno in ${!lines[@]} ; do
            local line="${lines[$lineno]}"
            local key
            local dnum
            local pnum
            local fnc
            local psize
            local ptype
            <<<$line read -r key dnum pnum fnc psize ptype
            case "$key" in
                '') continue        # skip empty lines
                ;;
                '#'*) continue      # skip comments
                ;;
                PARTITION)  # good
                ;;
                *) # bad
                    qReturnFail "invalid table line: $line"
                    return 1
                ;;
            esac
            if test "$dnum" = 0 ; then
                qReturnFail "invalid disk number $dnum"
                return 1
            fi
            local thisddev=${ddevs[$dnum]}
            if test -z "$thisddev" ; then
                qReturnFail "no disk specified for disk number $dnum"
                return 1
            fi
            if ! test "$dnum" = "$idisk" ; then
                continue
            fi
            local ddevpath=${mbuDevs[$ddev]}
            local pname="$pset-$fnc"
            >>$gdiskfile echo n     # Create new partition
            >>$gdiskfile echo $pnum  # parttion number
            >>$gdiskfile echo '+0'   # first sector ... +0 to use next avail
            local pendsector="$psize"
            case "$pendsector" in
                +*|-*) 
                    quser "using custom gdisk size on partition $pnum; $pendsector"
                ;;
                *M|*G) 
                    # prepend + to use relative addressing feature of gdisk based on size
                    # M (megabyte) and G (gigabyte) acceptable to gdisk
                    pendsector="+$pendsector"
                ;;
                *)  
                    # + to use relative addressing feature of gdisk based on size
                    # NOTE gdisk does NOT like large numbers!:
                    # convert to megabytes and append a +   (see gdisk man page)
                    pendsector='+'$(expr $psize / 1048576)M          # megabytes works with gdisk
                ;;
            esac
            >>$gdiskfile echo $pendsector  # last sector, see gdisk documentation
            local ptypecode='0000'  # default, partition with garbage p type code
            if ! mbuPtypeToId $ptype ; then
                qerror "do not know partition code for partition type $ptype"
                quser "Ignoring error and continuing as best we can"
            else
                qResult ptypecode
            fi
            >>$gdiskfile echo "$ptypecode"      # note, can be a uuid or gdisk code
            >>$gdiskfile echo c      # change partition name
            if test "$gdiskweird" = y ; then
                gdiskweird=n        # gdisk doesn't ask if only one part so far
            else
                >>$gdiskfile echo $pnum     # partition number
            fi
            >>$gdiskfile echo $pname          # partition name
            >>$gdiskfile echo p         # print table -- for diagnostics only
        done
        >>$gdiskfile echo p         # print table -- for diagnostics only
        >>$gdiskfile echo w         # write new table to disk! serious stuff
        >>$gdiskfile echo y         # confirmation for write
        # NOTE: gdisk actually quits after we confirm the write, so
        # we never actually get to the following:
        >>$gdiskfile echo p         # again, print table -- for diagnostics only
        >>$gdiskfile echo q         # quit gdisk
    
        # Now run gdisk
        qrun mbuDevRefreshNeed       # will need to refresh our disk info
        if test "$fakeit" = y ; then
            quser "NOT REALLY partitioning disk; see $gdiskfile for gdisk instructions"
        else
            qbug "running gdisk on $ddevpath , Stdin from $gdiskfile"
            if ! qrun diag=quser <"$gdiskfile" gdisk "$ddevpath" ; then
                qReturnFail "gdisk failed to partition disk"
                return 1
            fi
        fi
        quser "partitioned disk ok: $ddev"
        mbuDevRefreshNeed       # again, just in case
    
        # Now format file systems
        for lineno in ${!lines[@]} ; do
            local line="${lines[$lineno]}"
            local key
            local dnum
            local pnum
            local fnc
            local psize
            local ptype
            <<<$line read -r key dnum pnum fnc psize ptype
            case "$key" in
                '') continue        # skip empty lines
                ;;
                '#'*) continue      # skip comments
                ;;
                PARTITION)  # good
                ;;
                *) # bad
                    qReturnFail "invalid table line: $line"
                    return 1
                ;;
            esac
            if ! test "$dnum" = "$idisk" ; then
                continue
            fi
            local thisdev="$ddev$pnum"  # ASSUME we just add partition number
            local pname="$pset-$fnc"
            if test "$fakeit" = y ; then
                quser "NOT REALLY FORMATTING PARTION $pname of type $ptype on $thisdev"
            else
                if ! qrun mbuFormatPartition "$thisdev" "$ptype" ; then
                    qReturnFail "partition format failure for line: $line"
                    return 1
                fi
            fi
        done
    done        # end idisk loop through disks

    qrun mbuDevRefreshNeed       # once more, just in case
    quser "reformatted disks and partitions OK"
    qReturnOk ; return 0
}


##############################################################################
# mbuFormatI -- ask user some questions and then format disk(s)
##############################################################################
mbuFormatI_Help='
Help for mbuformat / mbuFormatI :

Interactive session to format a disk to be a new backup disk.
Here are the steps:

(1) You have the option of re-reading a partition table file, or creating
a new one.  The new one is created based entirely upon the current active
partition set. You may need to (copy and) modify it if your new disk will
differ significantly from your active disk (e.g. size). This is discussed
in greater detail in mbu-README.txt
You do not need to have a new disk connected for this step.

(2) As discussed in mbu-README.txt, you should attach the new disk(s),
wait for the operating system to recognize them, and then enter the disk
device names (e.g. sdb, sdc etc.) in the order that you want them used.
The first one will be used to backup the active Linux root partition and
accompanying partitions.

(3) You will be asked for a new partition set name, generally one that
you have not used before.

(4) The formatting operation proceeds. Assuming it is successful, the 
new disk(s) will have partitions named appropriately, and file systems
created, but will be empty and not have the correct UUIDs for bootability.
You will be prompted if you want to run mbup to fix this.
If you dont then you can run mbup at a later time to fix it.

(5) After mbup is successfuly completed, the new disk(s) are ready for use.
Be sure to disconnect the new disks when not needed to avoid future confusion.

Usage: [<option>]...

Options in any order:
    help|-help|--help   -- print this help message

Positional parameters:
    None.
'  # End of help message
mbuFormatI()
{
    qEnter "$@"  # our standard way to begin a function
    # Primary local variables:
    local result=''   # what we will return if successful

    # Options:
    dohelp=n
    qOption 'help:dohelp=y,-help:dohelp=y,--help:dohelp=y' "$@" ; shift $qresult
    if test $# -gt 0 ; then qReturnFail "Extra args: $@" ; return 1; fi

    # Help option
    if test "$dohelp" = y ; then
        printf "%s\n" "$mbuFormatI_Help" 
        qReturnOk ; return 0
    fi

    mbuActiveSetNameFind || true
    local fromset; qResult fromset
    
    ## %%%%%%%% TODO  maybe...
    ## %%%%% give choices (1) use existing table file
    ## %%%                (2) create table file based on entire disk 
    ##                                  then ask which disk
    ##                    (3) create table file based on partition set
    ##                          then ask for pset
    local mbuformatPrompt='MBUFORMAT---->'

    qprint "MBUFORMAT: ENTER filepath of MBU formatting table (if you have one)"
    qprint "... or just ENTER to make new one:"
    local tablefile=''
    qrun r=tablefile qUserRead promptbase="$mbuformatPrompt"
    
    if test -n "$tablefile" ; then
        if ! test -f "$tablefile" ; then
            qReturnFail "No such file: $tablefile" ; return 1
        fi
    else
        # table is independent of device and pset
        if ! mbuFormatTableWrite  ; then
            qerror "FAILED to write formatting table file!" ; return 1 ; fi
        qResult tablefile
        if test -z "$tablefile" ; then
            qerror "Unexpected error, no table file name"
            return 1
        fi
        qprint "HERE is the resulting file $tablefile"
        cat $tablefile
        qprint "PLEASE EXAMINE formatting script file at $tablefile (shown above)"
        qprint "You can modify it in another window if you want (save your changes elsewhere for the future)"
        qprint "MBUFORMAT: OK to continue? y/n:"
        qrun r=answer qUserRead promptbase="$mbuformatPrompt y/n : "
        case "$answer" in 
            y|Y) true
            ;;
            *) qReturnFail 'You did not say "y" ... Goodbye!' 
                return 1
            ;;
        esac
    fi
    
    # may be required if we aborted previously:
    mbuClean || qprint "MBFORMAT Ignoring mbuClean error"
    
    local diskdev=''
    lsblk -o NAME,PARTLABEL,MOUNTPOINTS,FSUSE%,SIZE,UUID
    qprint "MBUFORMAT: Above are connected disks, see which is your new disk!"
    qprint "MBUFORMAT: [Sometimes they don't show up for ten seconds or more]"
    qprint "MBUFORMAT: Also ensure your new disk(s) is/are BIG enough!"
    qprint "MBUFORMAT: ENTER device name e.g. sdb"
    qprint "MBUFORMAT: ... or multiple device names for multi-disk backup,"
    qprint "MBUFORMAT: ...... in the order as listed in $tablefile"
    qrun r=diskdev qUserRead promptbase="$mbuformatPrompt"
    if test -z "$diskdev" ; then
        qprint Goodbye.
        exit 1
    fi
    qprint "MBUFORMAT: ENTER new partition set name, USUALLY one NOT used before!"
    qrun r=pset qUserRead promptbase="$mbuformatPrompt"
    if test -z "$pset" ; then
        qprint Goodbye.
        exit 1
    fi

    >>$mbuMasterLogFile qprint `date +%Y/%m/%d-%H:%M:%S` START FORMAT $pset
    if ! mbuFormatDisk fake=n disk="$diskdev" pset="$pset" tablefile="$tablefile" ; then
        qerror "FAILED while formatting using: $diskdev $pset $tablefile"
        exit 1
    fi
    >>$mbuMasterLogFile qprint `date +%Y/%m/%d-%H:%M:%S` DONE- FORMAT $pset

    qprint "MBUFORMAT: OK to run ./mbup to copy files and repair bootability? y/n:"
    qrun r=answer qUserRead promptbase="$mbuformatPrompt y/n :"
    case "$answer" in 
        y|Y) true
        ;;
        *) 
            quser "NOW RUN ./mbup TO COPY OVER FILES AND MAKE BOOTABLE! Goodbye!"
            exit 0
        ;;
    esac

    if ! ./mbup ; then
        qerror "FAILED while to backup to our new disk"
        exit 1
    fi
    
    qprint $0: DONE FORMATTING/SYNCING OK `date +%Y/%m/%d-%H:%M:%S`
    qprint $0: "$qPretty_underline$qPretty_bold""DO NOT FORGET TO DISCONNECT OR TURN OFF THE BACKUP DISK!$qPretty_off"
    qReturnOk ; return 0
}

