}


##############################################################################
# mbuBackupSetCheck [<opt>]... -- Backup set contains all required partitions?
#       Partitions identified by function names in option fselection.
#       Backup set identified by set name in option outset.
#
#       Return value is <outset> if checks ok, otherwise empty.
#       Return status is 0 except in case of program error.
#
# Options:
#       outset=<pset> -- the set we are checking
#       fselection=[<fnc>...] -- which functions must be present
##############################################################################
mbuBackupSetCheck()
{
    qEnter "$@"  # our standard way to begin a function
    # Options:
    local outset=''
    local fselection=''
    qOption "outset,fselection," "$@" ; shift $qresult
    if test $# -gt 0 ; then qReturnFail "Invalid arg at: $*" ; return 1; fi
    if test -z "$outset" ; then qReturnFail "Missing set name at: $*"; return 1; fi
    qSClean t=, v=fselection        # convert commas to spaces and clean

    mbuDevRefreshMaybe
    if test -z "${mbuDevSets[$outset]:-}" ; then
        qReturnFail "Invalid partition set: $outset" ; return 1
    fi
    if test -z "$fselection" ; then qReturnOk "$outset" ; return 0 ; fi
    local fnc
    for fnc in $fselection ; do
        local partname="$outset-$fnc"
        local devpath
        mbuDevFind match=multiple ignore=y partname="$partname" ; qResult devpath
        if test -z "$devpath" ; then    # no partition by this hame
            quser "Partition set $outset does not contain partition $outset-$fnc"
            qReturnOk "" ; return 0       # soft fail
        fi
    done
    qReturnOk "$outset" ; return 0
}


##############################################################################
# mbuBackupSetNamesFind [<opt>]... -- find possible backup partition set(s)
#       The set being copied from (option fromset, default active set)
#       is excluded, as is any set which is missing any of the partition
#       functions listed via the fselection option.
#
#       Returns nonzero status on extraordinary error 
#       (e.g. can't find the active partition).
#       If there are no matches, an empty result is returned.
#       Return values via qresult.
#
#       Most likely reasons for not finding backup set(s):
#       - Backup disk is not connected
#       - Non-comformant partition naming
#       - Not all required partition functions provided.
#
# Options:
#       fromset=<setname>  -- set we are copying from (default active set)
#       fselection=<fnc>[ <fnc>]...  -- partition fncs that must be present
##############################################################################
mbuBackupSetNamesFind()
{
    qEnter "$@"  # our standard way to begin a function
    # Options:
    local fromset=''              # spec for partition to base search on
    local fselection=''         # partition fncs that must be present
    qOption "fromset,fselection," "$@" ; shift $qresult
    if test $# -gt 0 ; then qReturnFail "Invalid arg at: $*" ; return 1; fi

    mbuDevRefreshMaybe
    # Default, we are copying from the active set
    if test -z "$fromset" ; then fromset="$mbuDevActiveSet" ; fi
    # Look through all partition sets
    local allsets="${!mbuDevSets[*]}"
    qbug checking $allsets
    local sets=""
    local set
    for set in $allsets ; do
        if test "$set" = "$fromset" ; then
            true        # skip set we are copying from
        else
            # include only if all fncs included
            if ! mbuBackupSetCheck outset="$set" fselection="$fselection" ; then
                qReturnFail "At: $*" ; return 1
            fi
            qResult set         # may be empty
            sets="$sets $set"
        fi
    done
    qSClean v=sets

    case "$sets" in
        '') qbug "No backup sets found"
            qReturnOk ; return 0
        ;;
        *' '*) qbug "Multiple backup sets found: $sets"
            qReturnOk "$sets" ; return 0
        ;;
        *) qbug "Single backup set found: $sets"
            qReturnOk "$sets" ; return 0
    esac
}



##############################################################################
# mbuFncListGet <opt>... -- get list of partition name "functions" from set
#   Options: 
#       pset=<pset>    (default: active set, if any) (null value -> default)
#           <pset> is a partition set name (part of partition name before hyphen)
#           The "function" is the part of the partition name after the hyphen.
#           Return result in qresult.
#       bootfix={y}n}  -- y to add (to front of list) psuedo fnc named "-bootfix"
#               that indicates fixing bootability...
#               kind of a partition in that it involves the boot sectors of
#               the disk, although it also involves root, efi and boot partitions.
#   Returns nonzero on various errors, including no partitions found.
#   Return value is list of fncs, which will not be empty.
##############################################################################
mbuFncListGet() 
{
    qEnter "$@"  # our standard way to begin a function
    mbuDevRefreshMaybe
    local pset=''       # input
    local bootfix=n      # input
    qOption "pset,bootfix," "$@" ; shift $qresult
    if test $# -gt 0 ; then qReturnFail "At: $*" ; return 1 ; fi
    # Default to active partition set
    if test -z "$pset" ; then pset="$mbuDevActiveSet" ; fi
    if test -z "$pset" ; then qReturnFail ; return 1; fi
    local flist=''      # output
    if ! mbuDevProperty match=multiple partfnc partset="$pset" ; then
        qReturnFail ; return 1; fi
    qResult flist
    if test -z "$flist" ; then 
        qReturnFail "No partitions found for set: $pset" ; return 1 
    fi
    if test "$bootfix" = y ; then
        # Only supported for active set
        if test "$pset" = "$mbuDevActiveSet" ; then
            flist="-bootfix $flist"
        fi
    fi
    qReturnOk "$flist"  ; return 0
}
##############################################################################
# mbuFncSelectionWrite <selection> -- write partition function selection to a file
#       Since this is not mission critical, no errors generated.
##############################################################################
mbuFncSelectionWrite()
{
    qEnter "$@"  # our standard way to begin a function
    local filepath="$mbuOutDir/mbu-fnc-selection"
    local selection=${1:-''}
    # Replace spaces with commas so it reads nicely as one word
    selection=${selection//+([ ,])/,}
    mkdir -p $(dirname $filepath) # create directory for it to live in as needed
    echo "$selection" >"$filepath"
    qReturnOk ; return 0
}
##############################################################################
# mbuFncSelectionRead -- read partition function selection from a file
#       Since this is not mission critical, no errors generated, and
#       at worst you get an empty result.
##############################################################################
mbuFncSelectionRead()
{
    qEnter "$@"  # our standard way to begin a function
    local selection=''  # the result
    local filepath="$mbuOutDir/mbu-fnc-selection"
    if test -f "$filepath" ; then
        # File format: one line, containing the fnc names sep. by spaces
        <"$filepath" read selection
    fi
    # Convert to spaces instead of commas
    qSClean v=selection t=,
    # TODO %%% weed out invalid words
    qReturnOk "$selection" ; return 0
}
##############################################################################
# mbuFncSelectionShow <opt>..   -- show user what is selected
#   Options:
#       pset=<pset>   -- which partition set (default active)
#       fselection=[<fnc>...] -- which functions are selected
#       flist=[<fnc>...] -- which functions are allowed (default per pset)
# Does not fail. No return result
##############################################################################
mbuFncSelectionShow()
{
    qEnter "$@"  # our standard way to begin a function
    mbuDevRefreshMaybe
    local flist=''      # input, full list of legal fncs
    local pset=''       # input
    local fselection=''  # input
    qOption "pset,fselection,flist," "$@" ; shift $qresult
    if test $# -gt 0 ; then qReturnFail "At: $*" ; return 1 ; fi
    if test -z "$flist" ; then
        if ! mbuFncListGet pset="$pset" ; then qReturnFail ; return 1; fi
        qResult flist
    fi
    local fnc   # a partition function

    qprint
    qprint "    Note: Bootability fix available only from active set and"
    qprint "    implies backup of active root, boot and efi partitions."
    qprint "    Without boot fix, target disk might not be bootable."
    qprint
    qprint "Selection of Partitions in set $pset :"
    for fnc in $flist ; do
        local partname="$pset-$fnc"
        local mountpt=''
        local devpath=''
        local selshow=' '$qPretty_underline'No'$qPretty_off
        if test "$fnc" = -bootfix ; then
            partname="$fnc"
            mountpt="(fix bootability)"
            devpath=${mbuDevP_devpath["$mbuDevRootDiskDev"]}
            # special psuedo fnc
        else
            mbuDevProperty mountpt partname="$partname" ; qResult mountpt
            if test -z "$mountpt" ; then mountpt="(unmounted)" ; fi
            mbuDevProperty devpath partname="$partname" ; qResult devpath
        fi
        local selected
        for selected in $fselection ; do
            if test "$fnc" == "$selected" ; then selshow=$qPretty_green'Yes'$qPretty_off; fi
        done
        qprintf "%s %20s %-20s %s\n" "$selshow" "$partname" "$mountpt" "$devpath"
    done
    # Make a list with spaces to match flist
    local showselect=''
    for fnc in $flist ; do
        local selected
        for selected in $fselection ; do
            if test "$fnc" == "$selected" ; then
                showselect+="$qPretty_green$selected$qPretty_off "
                continue 2
            fi
        done
        # format spaces of the right length
        local len=${#fnc} ; local format="%$len""s"
        local temp; printf -v temp "$format" ''
        showselect+="$temp "
    done
    # Do not trim

    qprint
    qprint "Summary of partition functions:"
    qprint "All     : $flist"
    qprint "Selected: $showselect"
    qReturnOk ; return 0
}
##############################################################################
# mbuFncSelectionI [<opt>...]  -- interactive get function selection
#   Options:
#       pset=<pset> -- set partition set to use.
#               The special value of "active" selects the active set.
#       fselection=<flist>
#           Set starting list of partition functions, which user can override.
#           The list may be separated with commas or spaces or both
##############################################################################
mbuFncSelectionI()
{
    qEnter "$@"  # our standard way to begin a function
    local psetspec=''   # partition set to use, or "active" for active set.
    local fselection=''  # list of fncs

    # Get reading disk info out of the way first...
    # keeps the diagnostics cleaner looking.
    if ! mbuDevRefreshMaybe ; then
        qReturnFail ; return 1 ; fi   # shouldnt happen

    # Parse options
    qOption "pset:psetspec,fselection," "$@" ; shift $qresult
    if test $# -gt 0 ; then qerror "$@" ; fi
    qSClean v=fselection t=,
    if test -z "$psetspec" ; then psetspec=active ; fi

    qprint      # space for readability
    if test -n "$fselection" ; then
        qprint "Starting partition function selection:"
        qprint "    $qPretty_green$fselection$qPretty_off"
    else
        # Read previous list from file where it may have been saved
        mbuFncSelectionRead
        qResult fselection
        if test -n "$fselection" ; then
            qprint "Found previous partition function selection:"
            qprint "    $qPretty_green$fselection$qPretty_off"
        fi
    fi

    # Harass the user until they get the fnc list right
    while true ; do
        # Re-read system partition information each time
        # since there could be substantial time waiting for user
        # to respond.
        if ! mbuDevRefreshMaybe ; then
            qReturnFail ; return 1 ; fi   # shouldnt happen
    
        local pset="$psetspec"   # which partition set to base on
        if test "$psetspec" = active ; then   # special value
            # Determine our active set based on where / is mounted
            if ! mbuActiveSetNameFind ; then
                qReturnFail "cannot determine active partition set name"
                return 1
            fi
            qResult pset
        fi
    
        # Get list of the last part of partition names (aka the "function"
        # part of partition naame), for all partitions in current set
        # (sharing same first part of partition name).
        if ! mbuFncListGet bootfix=y pset="$pset" ; then  # (shouldn't happen) 
            qReturnFail "err 1" ; return 1
        fi
        local flist ; qResult flist
    
        # If no selection, select all
        if test -z "$fselection" ; then
            fselection="$flist"
            quser "Selecting all partition functions: $flist"
        fi
    
        # Allow only valid input words, and force order of flist
        qSListAnd "$flist" "$fselection" ; qResult fselection
        if test -z "$fselection" ; then
            qprint "No (valid) previous selections found."
            qprint "Selecting all partition functions: $flist"
            fselection="$flist"
        fi
    
        # Show user
        mbuFncSelectionShow pset="$pset" fselection="$fselection" flist="$flist"

        # Perhaps get a new list
        local oldselection="$fselection"
        # TODO %%% Display -all option without being distracting
        qUserRead promptbase='Enter selection' defaultvalue="$fselection"
        qResult fselection
        qSClean v=fselection
        case "$fselection" in 
            -all)
                fselection="$flist"
            ;;
        esac
        qprint

        # Keep asking so long as user keeps making changes
        #       otherwise we are done.
        if test "$fselection" = "$oldselection" ; then
            break
        fi
        # Try again...
        mbuDevRefreshNeed               # Time has passed...
    done

    # Here we are satisfied with the selection; 
    # Save it for next time!
    qprint "Saving selection for next time."
    mbuFncSelectionWrite "$fselection"
    qprint
    # And return it
    qReturnOk "$fselection"  ; return 0
}


##############################################################################
# mbuBackupScriptWrite [<option>...] -- 
#       Write a bash script to backup the active file systems to other partition set
#               and makes the target bootable.
#       See mbuBackupScript_Help below for options.
#
#       This identifies the active partition set by looking at the partition
#       that the unix root directory "/" is on.
#       It then looks for another partition set by looking for a matching
#       partition name with a different set name at the beginning.
#       If there are multiple, it fails.
#       [It would be possible to rewrite this to allow copying any set to another
#       set, but this would be a big change.]
#
#       On success status, qresult contains one of the following depending
#       on options:
#               The filepath of the (executable) putput script file
#               A message beginning with the word "echo"
#               Empty (e.g. if help was printed)
#       The output returned via qresult can always be appropriately 
#       executed as a shell command.
#
# NOTE NOTE NOTE this handles all options of the "mbup" program
#       and as such the help message below assumes you are running mbup.
##############################################################################
mbuBackupScript_Help='
This is part of the MBU backup system and will work only if your disk
partitions have been labelled in a conformant way... read the docs.
Basically, all partitions should be labelled:
        set-function
where "set" is a name shared only by all partitions on the same disk
(or set of disks), and function indicates your use of the partition.
Backup disks should have corresponding partitions, with the same
functions for partitions but a different set name.

Be sure to connect the backup disk first, and be sure to
DISCONNECT the backup disk when done!

By default, a backup script is created (overwriting any previous one)
and then executed.  
You can manually make a copy, modify it as desired, and execute script later.
Or more likely, you can just run ./mbup all the way to completion,
which generates a new backup script each time.

The backup script is based upon the partition set currently in use
when the script is actually run,
as determined by where the linux root filesystem (/) is mounted.
If you want to backup from a different partition set, you will need to
make a copy of the output script and then modify it.
However, note that bootability fixes only work when backing up from
the active partition set.

Having a backup disk attached is not required to generate the script.
The backup disk will be detected by the script when it runs.
If it is not auto-detected, then it will prompt you (but see ask option).
This allows re-using the same script for multiple backup disks,
although you can of course have it recreated each time.

The backup script (when executed) causes active disk partitions to be synced
over to matching backup disk partitions, including file system UUIDs,
and changes are made to the backup disk to ensure bootability.
Date stamp files are placed in both source and target partitions to help
in determining which backup is most up to date, although it will be easier
to look in the generated log files (if using mbup) if available.

To actually write to the backup disks requires root permission.
E.g.:   sudo bash
While I have tried to make it as safe is possible, there is inherent risk!

GENERAL OPTIONS are:
help | -help | --help -- print help for this message (only).
fselection=<fnc>[,<fnc>]...  -- list of partitions (by function part of name)
    The functions <fnc> are separated by commas (spaces work if quoted).
ask={y|n|m} -- ask questions before continuing?
    With ask=y, will always ask
    With ask=n, will never ask
    With ask=m, (maybe) will not ask if there is a clear single choice
bootfix={y|n} -- y to enable fixing bootability if possible (the default)
        Implies syncing / and /boot , 
        rewriting efi partition and fixing boot sectors
    WARNING syncing the / and /boot without fixing bootability
    afterwards may cause the backup disk to be unbootable!
o=<outfile>  -- specify filepath of created backup script 
                        (default $mbuDir/log/mbubackup.custom).
'  # END mbuBackupScript_Help ... beware of quote marks!
# TODO maybe: supplement or replace some options with new filtering using mlu
mbuBackupScriptWrite()
{
    qEnter "$@"  # our standard way to begin a function

    # Options:
    local dohelp=n
    local helpoptspec='help:dohelp=y,-help:dohelp=y,--help:dohelp=y,'
    local ask=${mbuask:-y}      # should script ask?
    local bootfix=y             # do we fix bootability?
    local outfile=''            # see default below
    local fselection=''      # List of partition functions
    qOption "ask,bootfix,o:outfile,fselection,$helpoptspec" "$@"
    shift $qresult

    # Get help out of the way
    if test "$dohelp" = y ; then
        qprint "$mbuBackupScript_Help" ; qReturnOk ; return 0
    fi

    # Clean up options
    if test $# -gt 0 ; then qReturnFail "At: $*" ; return 1 ; fi
    if test -z "$outfile" ; then 
        outfile="$mbuOutDir"/mbubackup.custom
    fi

    qSClean t=, v=fselection        # convert commas to spaces and clean
    # TODO add sanity check on words %%%%%%%%%
    if test -z "$fselection" ; then
        qReturnFail "Need a non-empty list of partition functions"; return 1
    fi

    # Some local variables
    local datestamp=$(date +%Y/%m/%d-%H:%M:%S)     # for diagnostics

    # Clear our memory of what we've done...
    if ! mbuSessionClean ; then 
        qReturnFail ; return 1 ; fi

    # Re-read system partition information
    if ! mbuDevRefreshMaybe ; then
        qReturnFail ; return 1 ; fi   # shouldnt happen

    # Determine our active set based on where / is mounted
    # we have to do this before looking at options or else greatly 
    # restructure the code.
    local fromset="$mbuDevActiveSet"
    if test -z "$fromset" ; then
        qReturnFail "Cannot determine active partition set name"
        return 1
    fi

    # Get the full list of fncs for this partition set
    local flist=''
    if ! mbuFncListGet bootfix="$bootfix" pset="$fromset" ; then
        qReturnFail ; return 1 ; fi
    qResult flist
    qSListAnd "$flist" "$fselection" ; qResult fselection
    if test -z "$fselection" ; then
        qReturnFail "No valid partition fncs" ; return 1
    fi
    fselection_full="$fselection"   # for logging

    # Here we remove the psuedo-fnc "-bootfix" which will be at the front
    case "$fselection" in
        -bootfix*) 
            fselection=${fselection#-bootfix}  # remove -bootfix
            qSTrim v=fselection
            # leave bootfix flag as is
        ;;
        *) bootfix=n    # turn off bootfix
        ;;
    esac
    case "$flist" in
        -bootfix*) 
            flist=${flist#-bootfix}  # remove -bootfix
            qSTrim v=flist
        ;;
    esac
    # flist and fselection are now only real partition functions

    # Set up a list of permissions fchoice[] per partition in our list
    # (identified by function fnc).
    # Values include:
    #   n -- omit partition
    #   y -- include partition
    local -A fchoice=( )  # per partition function status
    for fnc in $flist ; do fchoice[$fnc]=n ; done       # default, omit
    for fnc in $fselection ; do fchoice[$fnc]=y ; done  # unless selected

    # Now to get serious!
    local outefipart=''         # set only if we do them
    local outrootpart=''
    local outbootpart=''
    local outset=''        # note, we can generate script without it
    # Find a backup set, just to give better diagnostics
    qbug "Looking for possible OPTIONAL backup partition set, for better diagnostics..."
    if ! mbuBackupSetNamesFind fselection="$fselection" ; then
        quser "IGNORING: did not find a backup partition; diagnostics will suffer"
    else
        local outsets
        qResult outsets
        # Arbitrarily use first one
        shopt -s extglob     # Turn on extended features - should always be on!
        outset="${outsets%%+([[:blank:]])+([^[:blank:]])}"
    fi
    # In case of no backup sets, use the word MISSING (ugh... ugly)
    if test -z "$outset" ; then outset="MISSING" ; fi
    qbug "GUESSED possible backup partition set: $outset"

    quser "Writing file script: $outfile"
    quser "Writing script based on active source partition set : $fromset"
    quser "Diagnostics also consider possible output partition set : $outset"
    rm -f $outfile      # remove old one so permissions are appropriate (not +x until ready)
    mkdir -p $(dirname $outfile) # create directory for it to live in as needed
    >$outfile echo '#!/bin/bash'
    >>$outfile echo '#   Using custom MBU backup script generated at' $datestamp
    >>$outfile echo '#   Created from directory '$mbuDir' as: ' $outfile
    >>$outfile echo '#   CAUTION: This script generated automatically and may be out of date!'
    >>$outfile echo 'set -e  # abort on errors'
    >>$outfile echo '#   Here are the values of some important mbu variables'
    >>$outfile echo '#   at the time we produced the custom script (refer to mbulib for docs):'
    >>$outfile echo "cd $mbuDir"
    >>$outfile echo 'qDiagnosticPrefix=MBUSCRIPT'
    >>$outfile echo "mbuDir=$mbuDir"
    >>$outfile echo "mbuMountDir=$mbuMountDir"
    >>$outfile echo "mbuLogDir=$mbuLogDir"
    >>$outfile echo "mbuOutDir=$mbuOutDir"
    >>$outfile echo "qerror=$qerror"
    >>$outfile echo "quser=$quser"
    >>$outfile echo "qbug=$qbug"
    >>$outfile echo "#maybe, but already baked in:# mbuask=$mbuask"
    >>$outfile echo "mbuDoDateStampWrite=$mbuDoDateStampWrite"
    >>$outfile echo "mbuRsyncRetries=$mbuRsyncRetries"
    >>$outfile echo "mbuDoRsyncChecksum=$mbuDoRsyncChecksum"
    >>$outfile echo "mbuDoFsUuidCopy=$mbuDoFsUuidCopy"
    >>$outfile echo "mbuDoEfiUuidCopy=$mbuDoEfiUuidCopy"
    >>$outfile echo 'source ./mbulib || echo Perhaps your current directory should be '$mbuDir
    >>$outfile echo 'customscript()  {   # BEGIN CUSTOM BASH FUNCTION'
    >>$outfile echo 'set -eu  # abort on errors'
    >>$outfile echo 'local datestamp=$(date +%Y/%m/%d-%H:%M:%S)'
    >>$outfile echo 'quser $datestamp BEGIN Custom backup script generated at' $datestamp
    >>$outfile echo 'mbuClean quiet=y   # begin with a clean slate!'
    >>$outfile echo 'mbuSessionClean    # begin with a clean slate!'
    >>$outfile echo "#couldbe: local fromset=$fromset  # the partition set we copy from"
#    >>$outfile echo 'local ask=${mbuask:-'$ask'}'
    >>$outfile echo 'mbuActiveSetNameFind; local fromset ;qResult fromset  # the partition set we copy from'
    >>$outfile echo "#couldbe: local outset=$outset   # the partition set we copy to"
    >>$outfile echo "local outset=''   # the partition set we copy to"
    >>$outfile echo 'mbuBackupSetNamesFind fselection="'$fselection'" || true # if it failed, result will be empty'
    >>$outfile echo 'local outsets ; qResult outsets ; local nsets=$(qArgCount $outsets)  # the partition set(s) we can copy to'
    # Possibly interactive sanity checking (when running script) follows:
    >>$outfile echo 'if test "$nsets" -gt 1 ; then'
    if test "$ask" = n ; then
        >>$outfile echo 'qerror Too many backup choices! Goodbye!; return 1  '
    else
        >>$outfile echo 'echo; echo; qrun r=outset qUserRead promptbase="ENTER partition set to backup to, one of [$outsets]:"  '
    fi
    >>$outfile echo 'elif test "$nsets" = 0 ; then'
    if test "$ask" = n ; then
        >>$outfile echo 'qerror No backup partitions detected! Goodbye!; return 1 '
    else
        >>$outfile echo 'echo; echo; qrun r=outset qUserRead promptbase="ENTER partition set name to backup to (none found):" '
    fi
    >>$outfile echo 'else outset=$outsets '
    if ! test "$ask" = y ; then
        >>$outfile echo 'echo Auto-detected backup partition set: $outset '
    else
        >>$outfile echo 'echo; echo; local prompt="ENTER partition set to backup to: " '
        >>$outfile echo 'local input; qrun r=outset qUserRead promptbase="$prompt" defaultvalue="$outset"  '
    fi
    >>$outfile echo 'fi ; if test -z "$outset" ; then echo; echo; qerror Cannot continue without knowing backup set. Goodbye! ; return 1; fi'
    >>$outfile echo '>>$mbuMasterLogFile echo $(date +%Y/%m/%d-%H:%M:%S) START BACKUP FROM $fromset TO $outset'
    >>$outfile echo 'echo; echo; echo "BACKING UP PARTITION SET $fromset TO $outset" '
    qbug "Sync/Copy basic partitions from $fromset to $outset and maybe fix bootability..."
    local partsdone=''          # for diagnostic message only!
    >>$outfile echo 'local fncsdone=""'
    # BOOTABILITY FIXES (syncs root and boot also)
    if test "$bootfix" = y ; then
        # Find partitions for root, efi, and possibly boot
        # For the root partition this will be part of $fromset, but perhaps not for
        # boot and efi? should we worry about that? I'll not worry for now...
        if ! mbuPartFncNameFind / ; then qReturnFail "err 1" ; return 1 ; fi
        local rootfnc ; qResult rootfnc
        quser "Bootability fix: root FROM $fromset-$rootfnc"
        if ! mbuPartFncNameFind /boot ; then qReturnFail "err 2" ; return 1 ; fi
        local bootfnc ; qResult bootfnc
        if test "$bootfnc" = "$rootfnc" ; then
            bootfnc=''      # mark as not separate
            quser "Bootability fix: /boot is in root partition"
        else
            quser "Bootability fix: /boot FROM $fromset-$bootfnc"
        fi
        if ! mbuPartFncNameFind /boot/efi ; then qReturnFail "err 3" ; return 1 ; fi
        local efifnc ; qResult efifnc
        quser "Bootability fix: efi FROM $fromset-$efifnc"
        # Basic backup requuires root and efi partitions, plus boot partition if used.
        # These are all need to make the system bootable.
        outrootpart="$outset-$rootfnc"
        outbootpart=''
        if ! test -z "$bootfnc" ; then outbootpart="$outset-$bootfnc" ; fi
        outefipart="$outset-$efifnc"
        # Backup regular files for root and possibly boot partition
        >>$outfile echo 'mbuPartSync filepath=/ partname=$outset-'"$rootfnc"
        partsdone="$partsdone $outrootpart"
        >>$outfile echo 'fncsdone+=" '"$rootfnc"'"'
        mbuSessionPartMark "$fromset-$rootfnc" MBUMarkSourceBoot
        mbuSessionPartMark "$outrootpart" MBUMarkTarget
        if ! test -z "$bootfnc" ; then
            >>$outfile echo 'mbuPartSync filepath=/boot partname=$outset-'"$bootfnc"
            partsdone="$partsdone $outbootpart"
            >>$outfile echo 'fncsdone+=" '"$bootfnc"'"'
            mbuSessionPartMark "$fromset-$bootfnc" MBUMarkSourceBoot
            mbuSessionPartMark "$outbootpart" MBUMarkTarget
        fi
        # Now fix bootability issues. This does a lot of things including
        #   rewriting the efi partition, writing disk boot blocks,
        #   modifying both the output partitions and some changes to the
        #   active /boot directory.
        if test "$bootfix" = y ; then
            local outbootpart=''
            if ! test -z "$bootfnc" ; then
                outbootpart='$outset'-"$bootfnc"
            fi
            >>$outfile echo 'mbuBootFix outefipart=$outset-'$efifnc' outbootpart='$outbootpart' outrootpart=$outset-'$rootfnc "$@" 
            mbuSessionPartMark "$fromset-$efifnc" MBUMarkSourceBoot
            mbuSessionPartMark "$outefipart" MBUMarkTarget
            >>$outfile echo 'fncsdone+=" '"$efifnc"'"'
            mbuSessionBootFix=y
            >>$outfile echo 'mbuSessionBootFix=y'
            partsdone="$partsdone (fixed bootability)"
            >>$outfile echo 'fncsdone+=" -bootfix"'
        else
            >>$outfile echo 'echo WARNING: boot fix deselected.'
            >>$outfile echo 'echo WARNING: syncing root or boot partitions may cause backup disk to be UNBOOTABLE'
        fi
    fi

    # Now backup other partitions in the source set
    qbug "Sync other partitions from $fromset to $outset"
    local idev
    for idev in ${!mbuDevOrder[@]} ; do         # In canonical order
        local thisdevname=${mbuDevOrder[$idev]}
        local thisset=${mbuDevP_partset[$thisdevname]}
        local thisfnc=${mbuDevP_partfnc[$thisdevname]}
        local thispart=${mbuDevP_partname[$thisdevname]}
        local frompart="$fromset"-"$thisfnc"
        local outpart="$outset"-"$thisfnc"

        # Skip anything we did above for bootability
        if test -n "${mbuSessionPartRecord[$thispart]:-}" ; then
            qbug "Already did $thispart : ${mbuSessionPartRecord[$thispart]:-}"
            continue
        fi

        if test "$thisset" = "$fromset" ; then
            true        # a potential source
        else
            if test "$thisset" = "$outset" ; then
                if test -z "${mbuSessionPartRecord[$thispart]:-}" ; then
                    qbug "possible output partition we hope to match later : $thispart"
                else
                    qbug "partition looked at already: $thispart"
                fi
            else
                # If not part of from or out sets, mark it as skipped
                qbug "skipping partition not in set $fromset or $outset : $thispart"
                mbuSessionPartMark $thispart MBUMarkOtherSet
                #could be, but problems when sets change: >>$outfile echo mbuSessionPartMark $thispart MBUMarkOtherSet
            fi
            continue
        fi
        if test -z "$thisfnc" ; then qReturnFail ; return 1 ; fi # shouldn't happen?

        # Is fnc selected?
        local choice=${fchoice[$thisfnc]}
        case "$choice" in 
            'y') qbug "selected partition $thispart"
            ;;
            'n') qbug "deselected partition $thispart"
                mbuSessionPartMark "$frompart" MBUMarkDeselected
                mbuSessionPartMark "$outpart" MBUMarkSourceSkipped
                >>$outfile echo 'mbuSessionPartMark $fromset-'$thisfnc' MBUMarkDeselected'
                >>$outfile echo 'mbuSessionPartMark $outset-'$thisfnc' MBUMarkSourceSkipped'
                continue
            ;;
            *) qReturnFail "unhandled fnc flag $choice"
                return 1
            ;;
        esac    # end selection filter

        # Skip unhandled or non filesystems
        local fstype=${mbuDevP_fstype[$thisdevname]}
        if ! mbuFileSystemTypeIsMountable "$fstype" ; then
            qbug "skipping $outpart : unsupported file system type $fstype"
            if test "$fstype" = swap ; then
                mbuSessionPartMark "$frompart" MBUMarkSwap
                >>$outfile echo 'mbuSessionPartMark $fromset-'$thisfnc' MBUMarkSwap'
            else
                mbuSessionPartMark "$frompart" MBUMarkBadFs
                >>$outfile echo 'mbuSessionPartMark $fromset-'$thisfnc' MBUMarkBadFs'
            fi
            mbuSessionPartMark "$outpart" MBUMarkSourceSkipped
            >>$outfile echo 'mbuSessionPartMark $outset-'$thisfnc' MBUMarkSourceSkipped'
            continue
        fi
        qbug "Backing $frompart to $outpart"
        >>$outfile echo 'mbuPartSync partname=$fromset-'$thisfnc' partname=$outset-'$thisfnc
        mbuSessionPartMark "$frompart" MBUMarkSource
        mbuSessionPartMark "$outpart" MBUMarkTarget
        partsdone="$partsdone $outpart"
        >>$outfile echo 'fncsdone+=" '"$thisfnc"'"'
        qbug "sync $frompart $outpart done"
    done
    >>$outfile echo 'mbuClean    # end with a clean slate!'
    if test "$quser" = y ; then
        ### quser "here is what we did for backup script: =========="
        mbuSessionPrint prediction=y "SUMMARY OF THINGS TO DO"
        ### quser "above was just for backup script, didn't do it (yet)  =========="
    fi
    >>$outfile echo '>>$mbuMasterLogFile echo $(date +%Y/%m/%d-%H:%M:%S) DONE- BACKUP FROM $fromset TO $outset : $fncsdone'
    >>$outfile echo 'echo ---------------------------------------'
    # Some final information to be viewed by operator at the end of the operation:
    >>$outfile echo 'lsblk -o NAME,PARTLABEL,MOUNTPOINTS,FSUSE%,SIZE,UUID'
    >>$outfile echo 'echo ---------------------------------------'
    >>$outfile echo 'mbuSessionPrint "SUMMARY OF THINGS DONE"  # show user what happened'
    >>$outfile echo 'local datestamp=$(date +%Y/%m/%d-%H:%M:%S)'
    >>$outfile echo 'quser $datestamp ALL DONE OK using script generated at' $datestamp '.'
    >>$outfile echo '} # end function'
    >>$outfile echo 'customscript   # actually execute'
    chmod +x $outfile   # make it executable
    quser "Backup script written -- look at or execute $outfile"
    qReturnOk "$outfile" ;   # return result is filepath of script file
    return 0
}

##############################################################################
# mbuBackup -- interactive front end to doing a backup
#       Creates a backup script, and then executes it.
#       Arguments are +/- those for mbuBackupScriptWrite ; use "help" for help.
##############################################################################
# Here is help beyond that for mbuBackupScriptWrite:
mbuBackup_Help="
ADDITIONAL OPTIONS for mbup / mbuBackup are:
scriptonly={y|n} -- y to write output script file but do not execute it.

NOTES:

You can write your own custom two line script like:

#!/bin/bash
./mbup ask=m fselection=-bootfix,root,home,local

... assuming you have partitions named xxx-root, xxx-home and xxx-local,
and you want the backup disk to be made bootable.
With ask=m it will ask questions only if it really has to.
Or use ask=n to not be asked any questions at all.
"
mbuBackup()
{
    qEnter "$@"

    # Options
    local dohelp=n
    local fselection=''   # requested selection of "partition functions"
    local ask=${mbuask:-y}      # should script ask?
    local bootfix=y             # do we fix bootability?
    local scriptfile=''
    local scriptonly=n
    local helpoptspec='help:dohelp=y,-help:dohelp=y,--help:dohelp=y,'
    qOption "$helpoptspec,fselection,bootfix,ask,scriptonly=y,o:scriptfile,"  "$@"
    shift $qresult

    # Get help out of the way
    if test "$dohelp" = y ; then
        qprint 
        qprint "mbup [<opt>]...   -- perform backup of partitions of the active set."
        qprint "        With no partitions selected by options, enters interactive"
        qprint "        session with user (unless disabled by ask=n or ask=m)."
        qprint
        qprint "$mbuBackupScript_Help" 
        qprint "$mbuBackup_Help" 
        qReturnOk ; return 0
    fi

    # Clean up options
    if test $# -gt 0 ; then qReturnFail "At: $*" ; return 1 ; fi
  
    # Possibly interact with user to select partition functions to backup
    if test "$ask" = y || { test -z "$fselection" && test "$ask" = m ; } ; then
        if ! mbuFncSelectionI fselection="$fselection" ; then
            qReturnFail "Cannot proceed" ; return 1; fi
        qResult fselection
    fi
    if test -z "$fselection" ; then
        qReturnFail "No partitions selected" ; return 1 ; fi

    # Write the backup script, passing it many of our arguments.
    if ! mbuBackupScriptWrite fselection="$fselection" ask="$ask" bootfix="$bootfix" o="$scriptfile"
        then qReturnFail "Cannot proceed" ; return 1 ; fi
    qResult scriptfile

    if test "$scriptonly" = y ; then
        qprint $qPretty_green"Stopping after generating backup script: $scriptfile"$qPretty_off
        qReturnOk ; return 0
    fi

    # Here we have a script file... execute it
    quser Executing $scriptfile
    if ! qrun $scriptfile ; then
        quser "Attempting to clean up mounted files."
        if ! qrun mbuClean ; then
            qerror "Could not clean everything up!"
        fi
        qReturnFail "Terminating due to errors. Backup NOT completed. Goodbye!"
        return 1
    fi

    # All DONE
    quser $qPretty_green"FINISHED OK: $scriptfile AT $(date +%Y/%m/%d-%H:%M:%S)"$qPretty_off
    quser "$qPretty_underline$qPretty_bold""DO NOT FORGET TO DISCONNECT OR TURN OFF THE BACKUP DISK!$qPretty_off"
    qReturnOk ; return 0
}


