##############################################################################
# mbuFormatPartition <partdev> <ptype>  -- Format a partition partition
#       <ptype> can be a short name such as "ext4" or the parttype uuid.
#       See code below for supported partition types
##############################################################################
mbuFormatPartition()
{
    qEnter "$@"  # our standard way to begin a function
    local thisdev="${1:-}" ; shift||true
    local ptype="${1:-}" ; shift||true
    # Translate to a name if we can, otherwise hope for the best
    if mbuPtypeToName "$ptype" ; then qResult ptype ; fi
    case "$ptype" in
        '') qReturnFail "missing ptype: $ptype"
            return 1
        ;;
        ext4)
            if ! mbuFormatExt4 "$thisdev" ; then
                qReturnFail "failed to format $ptype partition on $thisdev"
                return 1
            fi
        ;;
        efi)
            if ! mbuFormatEfi "$thisdev" ; then
                qReturnFail "failed to format $ptype partition on $thisdev"
                return 1
            fi
        ;;
        swap)
            if ! mbuFormatSwap "$thisdev" ; then
                qReturnFail "failed to format $ptype partition on $thisdev"
                return 1
            fi
        ;;
        *)      # not one of the supported ones, try our luck as follows:
            if ! mbuFormatMisc "$ptype" "$thisdev" ; then
                qReturnFail "failed to format $ptype partition on $thisdev"
                return 1
            fi
        ;;
    esac
    quser "formatted partition $thisdev type=$ptype"
    qReturnOk ; return 0
}
