##############################################################################
# mbuFormatWipe [<opt>]... [=] [<devspec>]... -- 
#               Erase file system(s) and/or partition table from device(s)
#       <devspec> = input for mbuDevFind
# See help message below for options.
# 
# NOTE: Does all reasonable sanity checks before wiping anything.
# Fails if anything is mounted.
#
# CAUTION: it takes the operating system some time to catch up, even
# after partprobe is invoked.
##############################################################################
mbuFormatWipe_Help='
This functionally wipes out a disk or disk partition by erasing key
areas in the disk or partition.
Of course this is DANGEROUS, use with care.
Refuses to proceed if it detects a mounted filesystem, but dangers abound.

Usage: [<option>...] [=] <devspec>...
Options in any order:
    help|-help|--help   -- print this help message (only)
    ask={y|n}}          -- y to ask user before proceeding
Positional parameters (multiple allowed):
    <devspec>  -- specification of a partition or disk device ala mbuDevFind
'  # End of help message
mbuFormatWipe()
{
    qEnter "$@"  # our standard way to begin a function

    # Options:
    local dohelp=n
    local ask="${mbuask:-y}"
    qOption 'ask,help:dohelp=y,-help:dohelp=y,--help:dohelp=y,' "$@"
    shift $qresult

    # Help option
    if test "$dohelp" = y ; then
        printf "%s\n" "$mbuFormatWipe_Help" 
        printf "%s\n" "$mbuDevFind_SpecHelp"
        qReturnOk ; return 0 
    fi
    if test "${1:-}" = '=' ; then shift ; fi    # optional separator
    if test $# = 0 ; then
        qReturnFail "Use 'help' for help message" ; return 1
    fi

    mbuDevRefreshMaybe
    # Resolve input devices
    if ! mbuDevFind "$@" ; then 
        qReturnFail ; return 1 
    fi
    local selection ; qResult selection
    if test -z "$selection" ; then
        quser "No (valid) disk/partition selected... Goodbye!"
        qReturnOk ; return 0
    fi
    # Pull in children (partitions when disk specified) as well!
    local devname
    for devname in $selection ; do
        if ! mbuDevFind parentname="$devname" ; then
            qReturnFail; return 1
        fi
        local children;  qResult children
        selection="$selection $children"
    done
    # Run this through mbuDevFind again to clean it up
    if ! mbuDevFind $selection ; then 
        qReturnFail ; return 1 
    fi
    local selection ; qResult selection
    # Put partitions first, disks last
    #   Since logically one should erase a partition
    #   before it becomes undefined by erasing the disk
    #   partition table!
    local parts=''
    local disks=''
    local devname
    for devname in $selection ; do
        local devtype="${mbuDevP_devtype[$devname]}"
        case "$devtype" in
            part) parts+=" $devname" ;;
            disk) disks+=" $devname" ;;
            # ignore anything else
        esac
    done
    selection="$parts $disks"

    # Refuse to do anything if any is busy
    #   ... doing otherwise is a gateway to hell :~)
    if ! mbuDevBusyCheck $selection ; then
        qReturnFail ; return 1
    fi

    # interactive?
    if test "$ask" != n ; then
        qprint "THIS IS SERIOUS STUFF."
        qprint "Prepare to wipe partitions/disks:"
        local devname
        for devname in $selection ; do
            local partname="${mbuDevP_partname[$devname]}"
            qprintf "%20s %s\n" "$devname" "$partname"
            if ! mbuDevFind parentname="$devname" ; then
                qReturnFail; return 1
            fi
        done
        qUserRead promptbase='OK TO WIPE y/n ?' defaultvalue=n
        local answer ; qResult answer
        if test "$answer" != y ; then 
            qReturnFail "You did not say y" ; return 1 
        fi
    fi

    # Do the wiping
    local fail=n
    local devname
    for devname in $selection ; do
        local devpath="${mbuDevs[$devname]}"
        # Now wipe us. Note wipefs just removes key data, which is fast.
        quser "Wiping device $devname"
        if ! qrun diag=quser wipefs -a "$devpath" ; then
            qerror "Failure: wipefs $devpath" 
            fail=y
            # but keep going... do as much as we can...
        fi
    done
    # Optional???
    # Tell the operating system to look at everything
    # NOTE, this might better be done in mbuDevRefreshForce,
    # but in my experience partprobe only starts the discovery
    # process before it returns, and it takes many seconds to complete.
#?#    if ! partprobe "$devpath" ; then
#?#        qbug "Ignoring: partprobe failed" 
#?#    fi

    mbuDevRefreshNeed
    if test "$fail" = y ; then
        qReturnFail "Unable to completely wipe everything" ; return 1
    fi
    qReturnOk ; return 0
}
