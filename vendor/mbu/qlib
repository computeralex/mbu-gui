##############################################################################
# qSListAnd <string>...   -- find words present in all input strings
#       Order of words in first argument is preserved.
#       A word is a sequence of non-blank characters, separated by blank(s).
#       NOTE!!!: all strings must NOT contain bash special characters.
#       Return result via qresult.
#       Return status always 0.
##############################################################################
qSListAnd()
{
    # UGH, this is ineffient, but I don't know how to make it better
    qresult=''
    if test $# = 0 ; then return 0 ; fi
    local last="$1" ; shift
    while test $# -gt 0 ;  do
        local this="$1" ; shift
        local next=''
        # Keep order of "last"
        local lastword
        for lastword in $last ; do
            local thisword
            for thisword in $this ; do
                if test $lastword = $thisword ; then
                    next+=" $lastword"
                    continue 2
                fi
            done
        done
        last="$next"
    done
    qSClean v=last
    qresult="$last"
    return 0
}



##############################################################################
# qAGather <opt>... <arg>...  -- collect strings into sequentially indexed array.
#       Strings may be from various sources.
#       Order is preserved as much as possible (not possible for bash
#       associative arrays).
#   Options:
#       =      -- terminate options, additional args are strings to gather
#       =a     -- terminate options, additional args are arrays to gather from
#       =akeys -- terminate options, additional args are keys from arrays
#       ra=<varname> -- variable name for output (at end of processing)
#       va=<varname> -- variable name for input and output
#               Input is immediate, output at end of processing.
#       i=<varname> -- variable name (string) for input
#       ia=<varname> -- variable name (array) for input
#       s=<input>   -- input value
#   Order of options can be important:
#       -- Inputs are processed as soon as listed
#       -- Attribute options apply to succeeding inputs.
#   However, the last v or r option determines the output.
#   Arguments that don't look like a valid option end option parsing and
#   begin list of arguments to join.
#   With no input, output is empty array.
#   No default output.
##############################################################################
qAGather()
{
    local qq_ra=''       # variable name for result
    local -a qq_agather_result=( )  # final result
    while test $# -gt 0 ; do
        qOptionParse "$1"   # don't shift yet
        case "$qokey" in
            '') 
                if test "$qovalue" = '=' ; then shift ; fi
                break   # not an option
            ;;
            va)  # input varname
                qq_ra="$qovalue"
                local -n qq_nameref="$qovalue"
                qq_agather_result+=( "${qq_nameref[@]}" )
                shift ; continue
            ;;
            i)  # input varname
                local -n qq_nameref="$qovalue"
                qq_agather_result+=( "$qq_nameref" )
                shift ; continue
            ;;
            ia)  # input array varname
                local -n qq_nameref="$qovalue"
                qq_agather_result+=( "${qq_nameref[@]}" )
                shift ; continue
            ;;
            iakeys)  # input array (keys instead of values) varname
                local -n qq_nameref="$qovalue"
                qq_agather_result+=( "${!qq_nameref[@]}" )
                shift ; continue
            ;;
            s)  # input string
                qq_agather_result+=( "$qovalue" )
                shift ; continue
            ;;
            ra)
                qq_ra="$qovalue"
                shift ; continue
            ;;
            *)   # unrecognized
                # don't shift!
                break
            ;;
        esac
    done
    # Here with possibly unkeyed arguments which must be arrays to add
    if test $# -gt 0 ; then
        if test "$1" = '=a' ; then
            shift
            # arrays follow
            while test $# -gt 0 ; do
                local -n qq_nameref="$1"
                qq_agather_result+=( "${qq_nameref[@]}" )
                shift ; continue
            done
        elif test "$1" = '=akeys' ; then
            shift
            # associative arrays follow, use the keys
            while test $# -gt 0 ; do
                local -n qq_nameref="$1"
                qq_agather_result+=( "${!qq_nameref[@]}" )
                shift ; continue
            done
        else
            if test "$1" = '=' ; then shift ; fi # optional argument protector
            # Strings follow
            while test $# -gt 0 ; do
                qq_agather_result+=( "$1" )
                shift ; continue
            done
        fi
    fi
    # Store the result
    if test -n "$qq_ra" ; then
        local -n qq_nameref="$qq_ra"
        qq_nameref=( "${qq_agather_result[@]}" )
    else
        true    # error...  no output
    fi
    return 0
}
