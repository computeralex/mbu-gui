##############################################################################
# qSJoin [<opt>...] <arg>... -- join input strings together
#   Options:
#       =      -- terminate options, additional args are strings to join
#       =a     -- terminate options, additional args are arrays to gather from
#       =akeys -- terminate options, additional args are keys from arrays
#       r=<varname> -- variable name for output (at end of processing)
#       v=<varname> -- variable name for input and output
#               Input is immediate, output at end of processing.
#       i=<varname> -- variable name for input
#       s=<input>   -- input value
#       ia=<varname> -- input array values in bash order from array named <varname>
#       iakeys=<varname> -- input the keys in bash order of array named <varname>
#       sep=<sepstring> -- placed between succeeding outputs. Default, empty.
#       prefix=<prefix>  -- placed before each output. Default, empty.
#       suffix=<suffix>  -- placed after each output. Default, empty.
#   Order of options can be important:
#       -- Inputs are processed as soon as listed
#       -- Attribute options apply to succeeding inputs.
#   However, the last v or r option determines the output.
#   Arguments that don't look like a valid option end option parsing and
#   begin list of arguments to join.
#   Default input is empty string.
#   Default output is to echo to stdout
##############################################################################
qSJoin()
{
    local qq_sjoin_result=''  # final result
    local qq_x=''       # temporary variable
    local qq_once=n     # y if have processed one input
    # Options:
    local qq_r=''       # variable name for result
    local qq_sep=''     # separator between joined strings
    local qq_prefix=''  # placed before each addition
    local qq_suffix=''  # placed after each addition
    while test $# -gt 0 ; do
        qOptionParse "$1"   # don't shift yet
        case "$qokey" in
            '') 
                if test "$qovalue" = '=' ; then shift ; fi
                break   # not an option
            ;;
            v)  # input varname
                shift
                qq_r="$qovalue"
                local -n qq_nameref="$qovalue"
                qq_x="$qq_nameref"
                # fall thru
            ;;
            i)  # input varname
                shift
                local -n qq_nameref="$qovalue"
                qq_x="$qq_nameref"
                # fall thru
            ;;
            ia)  # input array varname
                shift
                local -n qq_nameref="$qovalue"
                for qq_x in ${qq_nameref[@]} ; do
                    if test "$qq_once" == y ; then qq_sjoin_result+="$qq_sep" ; fi
                    qq_once=y ; qq_sjoin_result+="$qq_prefix""$qq_x""$qq_suffix"
                done
                continue
            ;;
            iakeys)  # input array (keys instead of values) varname
                shift
                local -n qq_nameref="$qovalue"
                for qq_x in ${!qq_nameref[@]} ; do
                    if test "$qq_once" == y ; then qq_sjoin_result+="$qq_sep" ; fi
                    qq_once=y ; qq_sjoin_result+="$qq_prefix""$qq_x""$qq_suffix"
                done
                continue
            ;;
            s)  # input string
                shift
                qq_x="$qovalue"
                # fall thru
            ;;
            r) # result variable name
                shift
                qq_r="$qovalue"
                continue
            ;;
            sep) # separator between values
                shift
                qq_sep="$qovalue"
                continue
            ;;
            prefix)  # prefix before values
                shift
                qq_prefix="$qovalue"
                continue
            ;;
            suffix)  # suffix after values
                shift
                qq_suffix="$qovalue"
                continue
            ;;
            *)   # unrecognized
                # don't shift!
                break
            ;;
        esac
        # Here with a value to join in qq_x
        if test "$qq_once" == y ; then qq_sjoin_result+="$qq_sep" ; fi
        qq_once=y ; qq_sjoin_result+="$qq_prefix""$qq_x""$qq_suffix"
    done
    # Here with possibly unkeyed arguments which must be arrays to add
    if test $# -gt 0 ; then
        if test "$1" = '=a' ; then
            shift
            # arrays follow
            while test $# -gt 0 ; do
                local -n qq_nameref="$1"
                for qq_x in "${qq_nameref[@]}" ; do
                    if test "$qq_once" == y ; then qq_sjoin_result+="$qq_sep" ; fi
                    qq_once=y ; qq_sjoin_result+="$qq_prefix""$qq_x""$qq_suffix"
                done
                shift ; continue
            done
        elif test "$1" = '=akeys' ; then
            shift
            # associative arrays follow, use the keys
            while test $# -gt 0 ; do
                local -n qq_nameref="$1"
                for qq_x in "${!qq_nameref[@]}" ; do
                    if test "$qq_once" == y ; then qq_sjoin_result+="$qq_sep" ; fi
                    qq_once=y ; qq_sjoin_result+="$qq_prefix""$qq_x""$qq_suffix"
                done
                shift ; continue
            done
        else
            if test "$1" = '=' ; then shift ; fi # optional argument protector
            # Strings follow
            while test $# -gt 0 ; do
                qq_x="$1" ; shift
                if test "$qq_once" == y ; then qq_sjoin_result+="$qq_sep" ; fi
                qq_once=y ; qq_sjoin_result+="$qq_prefix""$qq_x""$qq_suffix"
            done
        fi
    fi
    # Store the result
    if test -n "$qq_r" ; then
        local -n qq_nameref="$qq_r"
        qq_nameref="$qq_sjoin_result"
    else
        echo "$qq_sjoin_result"
    fi
    return 0
}
