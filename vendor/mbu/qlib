##############################################################################
# qEval [<arg>]...     pass args to bash eval, this just adds debugging
#       Does qEnter/qReturnFail/qReturnOk
#       Status is return status from bash eval.
#       Return result via qresult is null.
#
# NOTE that bash eval does not present itself on the call stack trace!
# ALSO, the line number on the traceback for qEval somehow shoes up
# as "1" instead of the correct number... a bug in bash, how could that be?
##############################################################################
qEval()
{
    qEnter "$@"
    local qEval_status=0
    # NOTE: even "if" messes with $? so do it this way...
    eval "$@" || { qEval_status=$? ; }
    if ! test "$qEval_status" = 0 ; then
        qReturnFail "FAILURE (status $qEval_status) : $*"
        return "$qEval_status"
    fi
    qReturnOk
    return 0
}




##############################################################################
# qUserPrompt [<opt>]...     -- generate a prompt to use for user input request
#   Returns result via qresult; to actually print to user, use -print option.
#   Options are (leading hyphen optional):
#       promptshow={user|pipe|result}   -- where to put prompt
#               user - output to user (stderr), no return result  (the default)
#               pipe  -- output to stdout for e.g. using for $(qUserPrompt)
#               result  -- return via qresult
#               none   -- do not produce a prompt. Overrides other options.
#       promptbase=<string>  -- base part of the prompt
#               If <string> is empty then no base part is used.
#               If this option is missing, a default prompt is used.
#       defaultvalue=<string> -- if non-empty, the string is included
#               in the result to tell the user what the default or
#               suggested value is.
#       prettyprompt={y|n} -- prettify the result. The default is $qprettyprompt.
#
#   Features:
#           Provide a default prompt or use passed prompt base value (-prompt).
#           Optionally add indication of default value (see -default).
#           Prettify the result (see notes for -pretty).
#           Output, the first of:
#               Emit result to user on stderr
#                       If $quserreadok is not y this will produce error instead.
#               Emit result to stdout for use with e.g. $(qUserPrompt...)
#               Return result via qresult.
#
#   Prettyify means to add escape sequences to invoke "terminal" attributes 
#   (underline, bold, etc.)
#
# Examples:
#    Print a prompt to the user, if allowed, else error:
#       if ! qUserPrompt promptbase="myprompt" ; then qReturnFail ; return 1 ; fi
#    Get a prompt string via qresult:
#       local foo
#       qcall foo qUserPrompt promptshow=result promptbase="myprompt"
#    Get a prompt string via pipe:
#       local foo=$(qUserPrompt promptshow=pipe promptbase="myprompt")  
#      
# Note: Called from, and shares options with qUserRead.
##############################################################################
qUserPrompt()
{
    qEnter "$@"  # our standard way to begin a function

    # Get options
    local promptshow=''
    local promptbase=''     # base part of prompt to create
    local defaultvalue=''       # default value to include into prompt
    local prettyprompt="$qprettyprompt"    # should we use terminal display attributes
    qOption 'promptshow,promptbase,defaultvalue,prettyprompt' "$@"
    shift $qresult
    if test $# -gt 0 ; then qReturnFail "Invalid args at: $*" ; return 1 ; fi

    # Massages output option
    local douser="$quserreadok"      # do output to stderr (for user, see $greaduserok)
    local dopipe=n      # do output to stdout (as a return method)
    case "$promptshow" in 
        '') true ;;     # use defaults
        user) douser=y ; dopipe=n ;;
        pipe) douser=n ; dopipe=y ;;
        result) douser=n ; dopipe=n ;;
        none) qReturnOk ; return 0 ;;
        *) qerror "Ignoring invalid value for promptshow=$promptshow" ;;
    esac

    # Build up the prompt
    local prefix=''     # set attributes
    local dprefix=''    # prefix for default value
    local suffix=''     # cancel attributes
    if test -z "$promptbase" ; then promptbase="Enter Answer :" ; fi
    if test "$qprettyprompt" = y ; then
        prefix="$qPretty_underline"
        suffix="$qPretty_off"
    fi
    local defaultshow=''        # how we display the default
    if test -n "$defaultvalue" ; then
        defaultshow="[$defaultvalue]"
        if test "$qprettyprompt" = y ; then
            dprefix="$qPretty_off $qPretty_bold"
        fi
    fi
    local result
    printf -v result "$prefix%s$dprefix%s$suffix " "$promptbase" "$defaultshow"

    # Display the results
    if test "$douser" = y ; then
        qprintf "%s" "$result" 
        result=''  # one result only
        if test "$qbp" = y ; then 
            qprintf "\n%s\n" "$qPretty_magenta""qbp: WARNING, JUST PRINTED A PROMPT!""$qPretty_off"
        fi
    fi

    # Return the results
    if test "$dopipe" = y ; then
        echo "$result"
        result=''   # one result only
    fi
    qReturnOk "$result" ; return 0
}


##############################################################################
# qUserRead [<arg>...]  - read user input, return via qresult.
#       For list of arguments, see qUserPrompt.
#       If the user enters an empty input then default is returned instead,
#       if provided in the arguments, see args for qUserPrompt.
#
#       Fails and returns nonzero status if bash read returns nonzero...
#       e.g. end of file signal, or interrupt.
#       Also fails and returns nonzero status if quserreadok is not 'y'.
#      
# Typically used with qrun, e.g. :   qrun r=<varname> qUserRead <prompt> 
##############################################################################
qUserRead()
{
    qEnter "$@"  # our standard way to begin a function
    local result

    if test "$quserreadok" != y ; then 
        qReturnFail "User input disabled!" ; return 1
    fi

    # Print prompt using passed parameters, but override destination
    # (Note promptshow=none is not overridden).
    if ! qUserPrompt "$@" promptshow=user ; then   # print prompt using arguments
        qReturnFail ; return 1
    fi

    # Get options. Ignore options for qUserPrompt.
    local defaultvalue=''
    qOption 'QOIGNORE,defaultvalue' "$@" ; shift $qresult
    local status=0
    read result || { status=$? ; }
    if test "$status" != 0 ; then
        qprint   # newline to avoid jumbled text
        qReturnFail "Error $status reading user input" ; return 1
    fi
    if test -z "$result" && test -n "$defaultvalue" ; then
        result="$defaultvalue"  ; fi
    qReturnOk "$result" ; return 0
}


##############################################################################
# qFileFind <pattern>...  -- match shell file pattern with possible empty result
#               WARNING when calling, quote metacharacters!
#       This fixes the default shell behavior of empty results leading
#       to the pattern (e.g. with asterisks)  being simply returned as if it was valid.
#       Result returned via qresult
#       BUG: as usual, whitespace in a filename is disaster.
#
#       Return status is always 0
##############################################################################
qFileFind()
{
    qEnter "$@"  # our standard way to begin a function
    # NOTE: bash nullglob is not sufficient
    local result=''
    local match=$(echo $@)
    for f in $match ; do
        if test -e "$f" || test -L "$f" ; then
            if test -z "$result" ; then result="$f"
            else result="$result $f"
            fi
        fi
    done
    qReturnOk "$result" ; return 0
}



##############################################################################
# Q BREAKPOINT HANDLING STATE
# Breakpoints are wherever there is a call to qbreakpoint (see below).
# It is not possible to put breakpoints at arbitrary source lines
# (actually, it could be possible using trap DEBUG but that is not 
# implemented here).
#
# The call stack (provided by bash internal variables) is formatted into
# a "breakpath" name, consisting of [/<fnc>:<line>] concatenated together,
# starting with the most recent (omitting qbreakpoint itself).
# NOTE: we assume that functions have unique names.
#
# Also we create a "breakpoint" name that is just <fnc>:<line> of the
# caller of qbreakpoint. 
#
# These two names are stored in respective tables. 
# 
### Breakpoint data:
qbpoint_isinit=n        # y if we are ready to go
declare -A qbpoint_lookup=( )   # convert breakpoint into table index
declare -a qbpoint_reverse=( )  # convert table index into breakpoint
declare -a qbpoint_table=( )    # per breakpoint index, command to use
qbpoint_inext=0         # next index to use for breakpoint table additions
qbpoint_ilatest=0       # last breakpoint table index hit by qbreakpoint
### Breakpath data. Must be initialized in qStart.
qbreakpath_base=''         # our breakpath at qStart, which we can chop off
# TODO use qbreakpath_base to shorten reported breakpaths
declare -A qbpath_lookup=( )   # convert breakpath into table index
declare -a qbpath_reverse=( )  # convert table index into breakpath
declare -a qbpath_table=( )    # per breakpath index, command to use
qbpath_inext=0         # next index to use for breakpath table additions
qbpath_ilatest=0       # last breakpath table index hit by qbreakpoint


##############################################################################
# qBackTrace [<opt>].. -- format a backtrace
#               Result is returned via special global variable: qbt_result
#       Options are:
#               prefix=<string>  -- print string at begin of each line
#               style={short|long|bpath|bpoint}   
#                       long  -- multiline for user information
#                       short -- compressed single line for user info
#                       bpath -- "standard" breakpath form
#                       point -- "standard" breakpoint form,
#                               does only the first layer (see start=)
#               chop=<bpath> -- chop off <bpath> from result, if present.
#                       This is useful for style=bpath.
#               start=<n>  -- start at call depth <n>
# Note: this is independent of breakpoints or anything else.
# You could even call this (for debugging) from somewhere in your program.
#
##############################################################################
qbt_result=''   # return from qBackTrace here
# Possible upgrade: Would be nice to print breakpoint status when style=long form
qBackTrace()
{
    # Low level function, do NOT call qEnter or qReturnOk
    # CAUTION give unique names for all local variables in order to
    # preserve ability to see local variables in call stack!

    # Get options
    local qbt_options=''
    local qbt_style="long" ; qbt_options+='style:qbt_style,'
    local qbt_start=1  ; qbt_options+='start:qbt_start,'   # where we start in the backtrace
    local qbt_prefix=''  ; qbt_options+='prefix:qbt_prefix,'
    local qbt_chop='' ; qbt_options+='chop:qbt_chop,'
    qOption "$qbt_options" "$@" ; shift $qresult
    if test $# -gt 0 ; then qerror "Ignoring invalid args: $*" ; fi

    # Format the result
    local qbt_temp      # temporary holding space

    # Overall Prefix
    qbt_result=''       # start with empty result
    case "$qbt_style" in
        short)
            if test -n "$qbt_prefix" ; then 
                printf -v qbt_temp "%s " "$qbt_prefix" 
                qbt_result+="$qbt_temp"
            fi
        ;;
    esac

    # Per callback level...
    local qbt_depth
    for qbt_depth in ${!FUNCNAME[@]} ; do
        local qbt_linenum
        # Skip first ones as directed:
        if test $qbt_depth -lt "$qbt_start" ; then
            continue
        fi
        # Get the data for the callback level
        if test $qbt_depth = 0 ; then
            qbt_linenum=$LINENO
        else
            qbt_linenum=${BASH_LINENO[$(($qbt_depth-1))]}  
        fi
        local qbt_fncname=${FUNCNAME[$qbt_depth]} 
        local qbt_filename=$(basename ${BASH_SOURCE[$qbt_depth]})
        # Format according to style
        case "$qbt_style" in
            short)
                printf -v qbt_temp "[%s():%s:%s] " "$qbt_fncname" "$qbt_filename" "$qbt_linenum" 
                qbt_result+="$qbt_temp"
            ;;
            bpath)      # for "standard" breakpath use
                printf -v qbt_temp "/%s:%s" "$qbt_fncname" "$qbt_linenum" 
                qbt_result+="$qbt_temp"
            ;;
            bpoint)      # for "standard" breakpoint use
                printf -v qbt_temp "%s:%s" "$qbt_fncname" "$qbt_linenum" 
                qbt_result+="$qbt_temp"
                break   # first one only!
            ;;
            long|*)
                if test -n "$qbt_prefix" ; then 
                    qbt_result+="$qbt_prefix "
                fi
                printf -v qbt_temp "%2s %-20s %5s %s%s\n" \
                    "$qbt_depth" \
                    "$qbt_filename" \
                    "$qbt_linenum" \
                    "$qbt_fncname" \
                    ""
                qbt_result+="$qbt_temp"
            ;;
        esac
    done
    # Optional simplification for bpath case
    if test -n "$qbt_chop" ; then
        qbt_result="${qbt_result%$qbt_chop}"
    fi
    return 0
}


##############################################################################
# qbptPathCommandSet <ipath> <cmd>  -- set command for breakpath no. <ipath>
#       Do not use this the first time for <ipath>!
##############################################################################
qbptPathCommandSet()
{
    if test ! -v 1 ; then qerror ; return 1 ; fi
    if test ! -v 2 ; then qerror ; return 1 ; fi
    if test ! -v qbpath_table[$1] ; then 
            qerror "Invalid index: $1" ; return 1 ; fi
    qbpath_table[$1]="$2"
    qbug "Set breakpath $1 to [$2]"
    return 0
}

