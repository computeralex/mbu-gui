##############################################################################
# Prettyization constants
#       Escape Codes tell a terminal emulator to do special affects on 
#       characters following, such as color or boldness.
#       They originated with the VT100 terminal sold by Digital Equipment
#       Corporation, and eventually became a standard.
#       See: https://en.wikipedia.org/wiki/ANSI_escape_code
#
# CAVEATS: 
# They don't display prettily in a text editor, when looking at a log.
#
# NOTES:
# The $'...' form is necessary to interpret \e although \e is also recognized
# with the format argument of printf.
#
##############################################################################
qPretty_off=$'\e[0m'    # turn off text attributes
qPretty_blue=$'\e[34m'  # foreground color
qPretty_green=$'\e[32m'  # foreground color
qPretty_yellow=$'\e[33m'  # foreground color
qPretty_red=$'\e[31m'  # foreground color
qPretty_magenta=$'\e[35m' # foreground color
qPretty_underline=$'\e[4m'
qPretty_bold=$'\e[1m'
#.......... there are many more possiblities........


##############################################################################
# Diagnostic type information
##############################################################################
# Escape codes for pretty diagnostic attributes, by diagnostic type
#       if not present, no escape codes are used.
declare -A qDiagPrettyEscCodes=( )
qDiagPrettyEscCodes[FAIL]="$qPretty_red$qPretty_underline$qPretty_bold"
qDiagPrettyEscCodes[ERROR]="$qPretty_red$qPretty_underline$qPretty_bold"
qDiagPrettyEscCodes[OUCH]="$qPretty_red$qPretty_underline"  # internal q error
qDiagPrettyEscCodes[Status]=''
qDiagPrettyEscCodes[Debug]="$qPretty_blue"
qDiagPrettyEscCodes[Enter]="$qPretty_yellow"
qDiagPrettyEscCodes[DoneOk]="$qPretty_yellow"
qDiagPrettyEscCodes[Result]="$qPretty_green$qPretty_bold"



##############################################################################
# qDiagnostic <diagtype> <msg> 
#               Internal low level handling for diagnostic messages
#       <diagtype> is inserted into the diagnostic;
#               should be no longer than 6 characters for most pleasing results;
#               should match a table above for special handling.
#       NOTE that this is to be called TWO levels down from the original caller
#       
##############################################################################
qDiagnostic()
{
    # Low level function, do NOT use qEnter, do not even set qresult

    # CAUTION give unique names for all local variables in order to
    # preserve ability to see local variables in call stack!

    local qd_saveresult="$qresult" # because we might trash it
    local qd_esccode=''    # escape code for attributes
    local qd_escend=''     # end attributes escape code
    local qd_diagtype=OUCH
    if test $# -gt 0 ; then
        qd_diagtype="$1" ; shift
    fi
    if test "$qprettydiag" = y ; then
        qd_esccode=${qDiagPrettyEscCodes[$qd_diagtype]:-}
        if test -n "$qd_esccode" ; then 
            qd_escend="$qPretty_off"
        fi
    fi
    local qd_timestamp=''
    if test "$qDiagnosticsHaveTimeStamp" = y ; then
        printf -v qd_timestamp "%s" "$(date +%H:%M:%S)"
    fi
    local qd_linenum=${BASH_LINENO[1]}   # YES! 1 for caller of caller line number
    local qd_fncname=${FUNCNAME[2]}  # 2 for caller of caller function name
    local qd_msg="$*"
    qd_msg=${qd_msg##*([[:blank:]])}  # trim leading blanks

    # Try to make the messages line up by padding
    local qd_part1
    printf -v qd_part1 "%s:%s" \
        "$qd_fncname"      \
        "$qd_linenum" 
##### should work, but does not:
#    if test "$padlen" -gt 0 ; then
#        printf -v padding "%-""$padlen""s" ""
#    fi
###### Somehow I cant get printf %-<n>s to work consistently
    local qd_padlen=${#qd_part1}
    local qd_padding=' '   # ensure at least one char of padding
    while test "$qd_padlen" -lt 30 ; do
        qd_padlen=$((qd_padlen+1))
        qd_padding+=' '
    done
    local qd_dpadlen=${#qd_diagtype}
    local qd_dpadding=''
    while test "$qd_dpadlen" -lt 6 ; do
        qd_dpadlen=$((qd_dpadlen+1))
        qd_dpadding+=' '
    done
    local qd_tpadding=''
    if test -n "$qd_timestamp" ; then qd_tpadding=' ' ; fi

    qprintf "%s%s%s%s%s %s%s%s %s%s%s\n" \
        "$qDiagnosticPrefix" \
        "$qd_tpadding"     \
        "$qd_timestamp"    \
        "$qd_padding"      \
        "$qd_part1"        \
        \
        "$qd_esccode"      \
        "$qd_diagtype"     \
        "$qd_dpadding"     \
        \
        "$qd_msg"          \
        "$qd_escend"       \
        ""
        
    # we cant call qReturnOk as we are too low level. So this will do:
    qresult="$qd_saveresult"
    return 0
}


##############################################################################
# qbug -- print passed debug message to stderr and return success.
