##############################################################################
# qbptPathsList -- show content of breakpath table
##############################################################################
qbptPathsList()
{
    qEnter "$@"  # our standard way to begin a function
    local itable
    for itable in ${!qbpath_reverse[@]} ; do
        local path="${qbpath_reverse[$itable]}"
        local command="${qbpath_table[$itable]}"
        qprintf "%2s [%s] %s\n" "$itable" "$command" "$path"
    done

    qReturnOk ; return 0
}

