##############################################################################
# qSTransform <opt>... -- Transform input string to output, according to style.
#       The transformation style is given by style=<style> and 
#       other options may be appropriate depending on the style.
#       All input/output options appropriate for all styles.
#       With no input, the output will be empty.
#       Conflicting options (e.g. v vs. r and i) are randomly resolved.
#       Redundant occurrences of an option are resolved in favor of the last seen.
#       Default input is empty string.
#       Default output is to echo to stdout
#
#   Options appropriate for all styles:
#       style=<style> -- type of transform to do
#       v=<varname> -- variable name for input and output
#       i=<varname> -- variable name for input
#       s=<input>   -- input value
#       r=<varname> -- variable name for output
#   Options (appropriate according to style):
#       t=<trimchars> -- additional to trim besides whitespace
#           <trimchars> is treated as individual characters!
#           Caution! <trimchars> must not contain character (sequences)
#           not acceptable for bash pattern matching.
#           Safe values include comma (,), semicolon (;)  and slash (/)
# %%%%%%% TODO make all values of <trimchars> work
# %%%%%%% TODO find a way to make replacing spaces optional
#       sep=<separator> -- replacement for inside cleaning (inside=y)
#           Caution! <sepstring> must not contain character (sequences)
#           not acceptable for bash pattern replacement such as right brace.
# %%%%%%% TODO make all values of <separator> work
#
#   Values for <style> :
#   (default) -- no transformation, output is input
#   trim -- remove leading/trailing whitespace (and other chars*)
#       With t=<trimchars>, options, trim additional chars from ends besides
#       just other characters (see cautions above).
#   clean -- trim + merge multiple whitespace/<trimchars> into one space/<separator>
#       Does a trim first (see above), then sequences of trim characters 
#       inside the the string are replaced with a single space, or other
#       string specified with sep=<separator>
#   bashquote -- make string a single bash word, with single quotes,
#       including proper quoting of single quotes.
#       No options apply.
#   unbaskquote -- remove bask quoting, Fails badly if not actually bash quoted.
#
##############################################################################
qSTransform()
{
    # Use unique names so we don't hide the namespace of caller!!!!!

    # Options:
    local qq_style=''
    local qq_v=''
    local qq_i=''
    local qq_s=''
    local qq_r=''
    local qq_t=''
    local qq_sep=' '    # For inside replacement, default is a space
    qOption "style:qq_style,v:qq_v,i:qq_i,s:qq_s,r:qq_r,sep:qq_sep,t:qq_t," "$@" 
    shift $qresult
    if test $# -gt 0 ; then 
        qerror "Ignoring: $*" 
        qbreakpoint
    fi  # %%%%%% TODO
    # Obtain the input. Ignore redundanat specification.
    local qq_x=''       # our working value
    if test -n "$qq_v" ; then
        local -n qq_nameref="$qq_v"
        qq_x="$qq_nameref"
    elif test -n "$qq_i" ; then
        local -n qq_nameref="$qq_i"
        qq_x="$qq_nameref"
    elif test -n "$qq_s" ; then
        qq_x="$qq_s"
    else
        qq_x=''
    fi
    # Compute the result
    case "$qq_style" in
        trim)
            shopt -s extglob     # Turn on extended features - should always be on!
            qq_x=${qq_x##+([[:space:]$qq_t])}      # trim leading spaces
            qq_x=${qq_x%%+([[:space:]$qq_t])}      # trim following spaces
        ;;
        clean)
            shopt -s extglob     # Turn on extended features - should always be on!
            qq_x=${qq_x##+([[:space:]$qq_t])}      # trim leading spaces
            qq_x=${qq_x%%+([[:space:]$qq_t])}      # trim following spaces
            qq_x=${qq_x//+([[:space:]$qq_t])/$qq_sep}    # merge internal spacing
        ;;
        bashquote)
            # This makes a string not be interpreted, for bash source code.
            shopt -s extglob     # Turn on extended features - should always be on!
            qq_x=${qq_x//+(\')/\'\\\'\'}    # quote single quotes
            qq_x=\'"$qq_x"\'            # add single quotes around it
        ;;
        unbashquote)
            # This undoes bashquote. 
            # Sadly, this can't really be done properly without a character by character
            # state machine, which is grossly inefficient even by bash standards.
            # But bash can do it nicely of course...
            # TODO something more reliable (and efficient?)
            # Use eval to force the unquoting and protect trailing space w/ X...Z
            # Unfortunately, with set -e enabled, we have to take some steps to
            # avoid dieing in case of malformed input.
            # This we can do by first testing if it will die
            # and only if it doesn't then doing it with assignment to qq_x
            # (which apparently can't be otherwise protected).
            ( eval echo X"$qq_x"Z ) >/dev/null  && 
                qq_x=$(eval echo X"$qq_x"Z) 
            # In case of failure, the output is likely the input... ?
            # Now strip off the protecting X and Z
            qq_x=${qq_x#X}    
            qq_x=${qq_x%Z}    
        ;;
        *)      # unknown style
            true        # ignore
        ;;
    esac  # style
    # Store the result
    if test -n "$qq_v" ; then
        local -n qq_nameref="$qq_v"
        qq_nameref="$qq_x"
    elif test -n "$qq_r" ; then
        local -n qq_nameref="$qq_r"
        qq_nameref="$qq_x"
    else
        echo "$qq_x"
    fi
    return 0
}


