##############################################################################
# qbreakpoint -- add this to your code to (conditionally) execute a breakpoint
#       If conditions are right,
#       this will print some status and then enter the q debugger.
#       Return status is 0.
#
# Breakpoints are active ONLY if qbp=y (see top of file).
#
# If active, then at each call to qbreakpoint:
#
# -- The call stack (provided by bash internal variables) is formatted into
# a "breakpath" name, consisting of [/<fnc>:<line>] concatenated together,
# starting with the most recent (omitting qbreakpoint itself).
# NOTE: we assume that functions have unique names.
#
# -- Also we create a "breakpoint" name that is just <fnc>:<line> of the
# caller of qbreakpoint. 
#
# -- The first time we see one of these names, we add it to the respective
# breakpath or breakpoint table, with a default command "y" (see below).
#
# -- We now look in the breakpath and breakpoint tables to obtain the commands
# for the given breakpath and breakpoint.
# For each the command may be one of:
#       y [<action>]   -- enable this breakpath/breakpoint
#       n [<action>]   -- disable this breakpath/breakpoint
#
# -- If both breakpath and breakpoint have a 'y" (enable) command, then we
# will execute an "enable action" else a "disable action", see below.
#
# -- If we are to execute an "enable action", then we will execute an <action>
# as found in the following order:
#       -- If an action is provided for the breakpath, we use that.
#       -- Else if an action is provided for the breakpoint, we use that.
#       -- Else we use the action defined in $qbpoint_defaultcmd
# The action is then evaluated as a bash shell script using bash "eval".
# Typically this will include a call to qDebuggerI to enter the debugger.
#
# -- If we are to execute a "disable action", then we will execute an <action>
# as found in the following order:
#       -- If command for breakpath is "n" and has an action, we use that.
#       -- Else if command for breakpoint is "n" and has an action, we use that.
#       -- Else we use action defined in $aqbpoint_altcmd
#
# -- Each <action> is a shell script to be passed to bash "eval" to execute.
# Typically "enable" commands will make a call to qDebuggerI whereas "disable"
# calls will not, but there are no hard rules.
#
##############################################################################
qbpoint_latest='bogus'       # last breakpoint hit by qbreakpoint
qbpath_latest='bogus'       # last breakpath hit by qbreakpoint, cleared by debugger
qbreakpoint()
{
    # LOW LEVEL, do NOT call qEnter or qReturnOk

    # CAUTION give unique names for all local variables in order to
    # preserve ability to see local variables in call stack!

    # Do nothing unless initialized
    if ! test "$qbpoint_isinit" = y ; then
        return 0
    fi

    # Do nothing unless interactive debugging turned on
    if test "$qbp" != y ; then 
        return 0
    fi

    local qbreakpoint_saveresult="$qresult"        # save qresult for restoral

    # Get current breakpoint name / index in table
    #  Deliberately shadow qbpoint_latest, which is used for debug info messages
    local qbpoint_latest=''       # last breakpoint hit by qbreakpoint
    qBackTrace start=2 style=bpoint ; qbpoint_latest="$qbt_result"
    qbpoint_ilatest=${qbpoint_lookup[$qbpoint_latest]:-}
    if test -z $qbpoint_ilatest ; then
        # Not present in table ... add it
        qbpoint_ilatest=$qbpoint_inext
        qbpoint_inext=$((qbpoint_inext + 1))
        qbpoint_lookup[$qbpoint_latest]=$qbpoint_ilatest
        qbpoint_reverse[$qbpoint_ilatest]=$qbpoint_latest
        qbpoint_table[$qbpoint_ilatest]='y'  # enabled, default action
    fi
    local qbpoint_command=${qbpoint_table[$qbpoint_ilatest]}
    # Command, if any, starts at 3rd character
    local qbpoint_action=''
    case "$qbpoint_command" in
        ?) true  ;;         # single character command
        *) # assume command letter, space, subcommand
            qbpoint_action=${qbpoint_command#??} 
        ;;
    esac

    # Get current breakpath name / index in table
    #  Deliberately shadow qbpath_latest, which is used for debug info messages
    local qbpath_latest=''       # last breakpath hit by qbreakpoint
    qBackTrace start=2 style=bpath ; qbpath_latest="$qbt_result"
    qbpath_ilatest=${qbpath_lookup[$qbpath_latest]:-}
    if test -z $qbpath_ilatest ; then
        # Not present in table ... add it
        qbpath_ilatest=$qbpath_inext
        qbpath_inext=$((qbpath_inext + 1))
        qbpath_lookup[$qbpath_latest]=$qbpath_ilatest
        qbpath_reverse[$qbpath_ilatest]=$qbpath_latest
        qbpath_table[$qbpath_ilatest]='y'
    fi
    local qbpath_command=${qbpath_table[$qbpath_ilatest]}
    # Command, if any, starts at 3rd character
    local qbpath_action=''
    case "$qbpath_command" in
        ?) true ;;            # single character
        *) qbpath_action=${qbpath_command#??}  ;;
    esac

    # Do we use an enable action or disable action?
    local qbreakpoint_pointenable=n
    case "$qbpoint_command" in
        y|'y '*) qbreakpoint_pointenable=y ;;
    esac
    local qbreakpoint_pathenable=n
    case "$qbpath_command" in
        y|'y ') qbreakpoint_pathenable=y ;;
    esac
    local qbreakpoint_enable=n          # combined result
    if test "$qbreakpoint_pointenable" = y && 
                    test "$qbreakpoint_pathenable" = y ; then
        qbreakpoint_enable=y 
    fi

    # Find which action to use
    local qbreakpoint_action=''
    if test "$qbreakpoint_enable" = y ; then  # enable
        #       -- If an action is provided for the breakpath, we use that.
        if test -n "$qbpath_action" ; then
            qbreakpoint_action="$qbpath_action"
        #       -- Else if an action is provided for the breakpoint, we use that.
        elif test -n "$qbpoint_action" ; then
            qbreakpoint_action="$qbpoint_action"
        #       -- Else we use the action defined in $qbpoint_defaultcmd
        else
            qbreakpoint_action="$qbpoint_defaultcmd"
        fi
    else        # disable
        #       -- If command for breakpath is "n" and has an action, we use that.
        if test "$qbreakpoint_pathenable" = n && test -n "$qbpath_action" ;  then
            qbreakpoint_action="$qbpath_action"
        #       -- Else if command for breakpoint is "n" and has an action, we use that.
        elif test "$qbreakpoint_pointenable" = n && test -n "$qbpoint_action" ;  then
            qbreakpoint_action="$qbpoint_action"
        #       -- Else we use action defined in $qbpoint_altcmd
        else
            qbreakpoint_action="$qbpoint_altcmd"
        fi
    fi
    if test -z "$qbreakpoint_action" ; then
        qerror "Unexpected: No command found; go to debugger"
        qbreakpoint_action="qDebuggerI"
    fi

    # Tricky part: don't pile up break points... that is bad news!
    # Disable qbp so we don't re-enter.
    # That would be a problem except if we go to the interactive debugger,
    # which can enable it again... if appropriate... tricky...
    # The variable qbpoint_qbp (below) will be used by qDebuggerI
    # as the value to restore to.
    # Since it is "local" it will shadow any nested calls to us.
    local qbpoint_qbp="$qbp" ; qbp=n

    # Execute the action
    qbug "Breakpoint Reached: path#$qbpath_ilatest point#$qbpoint_ilatest trace=$qbpath_latest"
    qbug "... enabled=$qbreakpoint_enable action=[$qbreakpoint_action]"
    # The following must be "eval" and NOT "qEval" to avoid unwanted recursion
    eval "$qbreakpoint_action" || qerror "Ignoring error from: $qbreakpoint_action"
    qbug "Breakpoint Done, qresult=[$qresult],  from $qbpath_latest"

    # re-enable ... possibly as modified by qDebuggerI
    qbp="$qbpoint_qbp"

    qresult="$qbreakpoint_saveresult"      # restore
    return 0
}


##############################################################################
# qDebuggerI -- interactive debugger, reads lines from user, 
#       and executes commands, which can lead to complicated stuff.
#       Does NOT enable breakpoints (qbp=y) automatically.
#
#       See help message below.
#
#       Note there are three ways of executing commands:
#       r -- only simple commands accepted.
#       v -- any bash statement is ok, so long as it fits on a line ("eval")
#       if no match, is treated like v
##############################################################################
qDebuggerI_Help='
Q Debugger commands:
Input is evaluated as a bash command line (bash eval), unless it is one of:
h -- for this help message            c -- continue execution (leave debugger)
q -- exit program                     t -- print backtrace
l -- list breakpaths                  L -- list breakpoints
b -- disable current breakpath        B -- disable current breakpoint
e -- edit breakpaths                  E -- edit breakpoints
r <cmd> ...  -- run command ala qrun  v <cmd>... -- eval <cmd>... using bash
' # end help message
qDebuggerI_level=0      # Internal use ; see also qStart
qDebuggerI_lastlevel=0  # Internal use
qDebuggerI_once=n       # Internal use; detect first time
qDebuggerI()
{
    # Low level function, do NOT call qEnter or qReturnOk

    # CAUTION give unique names for all local variables in order to
    # preserve ability to see local variables in call stack!

    qTrapDisable   # avoid unwanted recursion

    # Keep track of recursion level
    local qdbi_level=$((qDebuggerI_level + 1))
    qDebuggerI_level=$qdbi_level
    # Are we resuming?
    local qdbi_lastlevel="$qDebuggerI_lastlevel"
    qDebuggerI_lastlevel="$qDebuggerI_level"

    local qdbi_ourname="QDBUG[$qdbi_level]"
    local qdbi_fail=n   # y for fatal failure, s for soft failure
    local qdbi_qresult="$qresult" # save

    local qdbi_qbp="$qbp"   # what we restore qbp to
    # Special hack... if called from qbreakpoint !!! 
    #   ... reset break point enable to condition on entering qbreakpoint
    if test -v qbpoint_qbp ; then
        qdbi_qbp="$qbpoint_qbp"
    fi
    qbp=n  # Save and turn off

    local qdbi_qbug="$qbug"  # Save for later restoral
    qbug=n   # Turn off debugs, would make the menu too hard to use
    
    local qdbi_ifrom=''  # index in breakpath table

    qprint ; qprint  # Give some break in the output

    if test $# -gt 0 ; then qbug "Ignoring input args: $@" ; fi

    # Get ourselves to the end if we had a failure. Too bad we don't have "goto".
    if test "$qdbi_fail" = n ; then
        # Here to really enter the debugger
        if test "$qdbi_lastlevel" = "$qdbi_level" ; then
            qprint ; qprint "$qdbi_ourname CONTINUING level $qdbi_level (h for help)"
        elif test "$qdbi_lastlevel" -lt "$qdbi_level" ; then
            qprint ; qprint "$qdbi_ourname ENTERED level $qdbi_level (h for help)"
        else
            qprint ; qprint "$qdbi_ourname RESUMED at level $qdbi_level (h for help)"
        fi
        if test "$qDebuggerI_once" != y ; then
            # First time

            # Since the debugging user is likely to mistype things, it might be nice to
            # turn off set -eu protections because they cause fatal errors to the program
            # But that isn't always the best idea.
            # Hmmmm

            # First time warnings
            if test "$qdbi_qbug" != y ; then
                qprint "NOTE! Debug messages not enabled. Enter: qbug=y" ; fi
            if test "$qdbi_qbp" != y ; then
                qprint "NOTE! Breakpoints not enabled. Enter: qbp=y" ; fi
        fi
        # Print breakpath... convenient call stack tracepack
        if test -n "$qbpath_latest" ; then
            qprint "$qPretty_magenta""AT BREAKPATH""$qPretty_off"" $qbpath_ilatest : $qbpath_latest"
        fi
        # Printing the breakpoint might seem superfluous, but it helps the user tell the
        # difference between a breakpath and a breakpoint.
        if test -n "$qbpoint_latest" ; then
            qprint "$qPretty_magenta""AT BREAKPOINT""$qPretty_off"" $qbpoint_ilatest : $qbpoint_latest"
        fi
        # Loop on user inputs until told to break the loop,
        #       after which we can return to caller and continue program.
        while test "$qdbi_fail" = n ; do
            if ! qUserRead "promptbase=$qdbi_ourname>" "defaultvalue=$qbugi_command" ; then
                qdbi_fail=y
                qerror "Aborting due to read error"
                break
            fi
            # Debug messags from evaluating qresult via e.g. qResult
            # would just be too much. So use qresult directly.
            local qdbi_inline="$qresult" ; qresult=''
            local qdbi_args="${qdbi_inline#??}"
            # Look for our special commands, else pass to bash eval
            case "$qdbi_inline" in
                h|'h '*)  # h = "help"
                    qprintf "%s\n" "$qDebuggerI_Help"
                    continue
                ;;
                c)  # c = "continue"
                    break           # break loop and return to caller
                ;;
                q|'q '*)  # q = "quit
                    qprint "$qdbi_ourname: Aborting program... Goodbye!"
                    qbug=$qdbi_qbug   # restore debugs
                    qbp=$qdbi_qbp   # restore
                    qTrapDisable
                    exit 0
                    return 1  # not reached
                ;;
                t)    # print backTrace
                    qBackTrace start=2 
                    qprint "$qbt_result"
                    continue
                ;;
                b)  # disable current breakpath
                    qbptPathCommandSet "$qbpath_ilatest" "n"
                    continue
                ;;
                B)  # disable current breakpoint
                    qbptPointCommandSet "$qbpoint_ilatest" "n"
                    continue
                ;;
                l)  # list breakpaths
                    qbptPathsList 
                    continue
                ;;
                L)  # list breakpoints
                    qbptPointsList 
                    continue
                ;;
                e)  # edit breakpaths
                    qbptPathsEdit || true
                    continue
                ;;
                E)  # edit breakpoints
                    qbptPointsEdit || true
                    continue
                ;;
                r|'r '*)  # r = "run"
                    qprint "$qdbi_ourname: Running: $qdbi_args"
                    set -- "$qdbi_args"        # put results into $@
                    qbug=$qdbi_qbug   # restore debugs
                    qbp=$qdbi_qbp   # restore debugs
                    qTrapEnable
                    { $@ ; } || { qbug=n qerror "That failed (ignored)" ; }
                    qTrapDisable   # avoid unwanted recursion
                    qdbi_qbug="$qbug" ; qbug=n  # save and then turn off qbug
                    qdbi_qbp="$qbp" ; qbp=n  # save and then turn off qbp
                    qprint "$qdbi_ourname: RESULT: $qresult"
                    continue
                ;;
                t)    # print backTrace
                    qBackTrace start=2 
                    qprint "$qbt_result"
                    continue
                ;;
                v|'v '*)  # v = "eval" ... useful to escape our own commands
                    # drop through
                ;;
                *) # other input
                    qdbi_args="$qdbi_inline"
                    # drop trough
                ;;
            esac
            # unmatched, or remainder of v command ... use bash eval
            qprint "$qdbi_ourname: Evaling: $qdbi_args"
            qbug=$qdbi_qbug   # restore debugs
            qbp=$qdbi_qbp   # restore debugs
            local qdbi_status=0
            qdbi_fail=n
            qTrapEnable
            qEval "$qdbi_args" || {  qdbi_fail=y; } 
            qTrapDisable
            qdbi_qbug="$qbug" ; qbug=n  # save and then turn off qbug
            qdbi_qbp="$qbp" ; qbp=n  # save and then turn off qbp
            if test "$qdbi_fail" = y ; then
                qerror "That failed (ignored)"
                qdbi_fail=n
            fi
            qprint; # give some separation
            qprint "$qdbi_ourname: DONE. RESULT=[$qresult] FROM=[$qdbi_args] "
            continue
        done
    fi
    # Here if we broke the loop
    if test "$qdbi_fail" = y ; then
        qerror "Aborting due to errors" 
    else
        qprint "$qdbi_ourname: Continuing..."
    fi
    # CLEAN UP! Make sure we come through here... even if we will exit
    #   (since we could trap the exit)
    qbpath_latest=''    # once only
    qbpoint_latest=''    # once only
    qbug=$qdbi_qbug   # restore
    qbp="$qdbi_qbp"   # restore 
    qresult="$qdbi_qresult"  # restore
    qDebuggerI_lastlevel="$qDebuggerI_level"
    qDebuggerI_level=$((qdbi_level - 1))
    qDebuggerI_once=y
    # Low level fnc, do NOT call qReturnOk
    if test "$qdbi_fail" = y ; then
        exit 1
    fi
    qTrapEnable
    return 0
}


##############################################################################
# qTrapHandlerAdd <fncname> -- add a trap handler to list to call on exception.
#       <fncname> is the name of the trap handler.
#
#       Returns 0 status. No return value.
#
#       It is okay to call redundantly.
#       Call this just before calling qStart, so that
#       trap handlers for lower level systems are called first.
##############################################################################
declare -a qTrapHandlers=( )    # indexed list of trap handlers
qTrapHandlerAdd()
{
    local ihandler
    local handler="$1"
    for ihandler in ${!qTrapHandlers[@]} ; do
        local otherhandler=${qTrapHandlers[ihandler]}
        if test "$otherhandler" = "$handler" ; then
            return 0
        fi
    done
    qTrapHandlers+="$handler"
    ### declare -p qTrapHandlers  # DEBUG %%%%%%%%%
    return 0
}


##############################################################################
# qTrapHandler -- may be called on exceptions
#       Other trap handlers might call this one before doing their
#       cleanup, while the evidence is still fresh...
##############################################################################
qTrapHandler()
{
    # If we got here, we must have been enabled, but just in case
    qtrap=y    # So qTrapDisable will work for sure
    qTrapDisable  # don't trap again... can cause unwanted recursion
    # Tell user:
    # DO NOT CALL qerror etc. as that leads to unwanted recursion
    qprint "$qPretty_red""TRAPPED EXCEPTION! Back trace:""$qPretty_off"
    qprint "(Note: bash often trashes line number of level 2)"
    qBackTrace style=long && qprint "$qbt_result"
    qprint "$qPretty_red""TRAPPED EXCEPTION! (Cleaning up)""$qPretty_off"
    # If breakpoints are enabled, maybe go to debugger or something
    qbreakpoint         # definitely should be a breakpoint! May call debugger
    # Now call application trap handlers
    local ihandler
    for ihandler in ${!qTrapHandlers[@]} ; do
        qtrap=y    # So qTrapDisable will work for sure
        qTrapDisable  # don't trap again... can cause unwanted recursion
        local handler=${qTrapHandlers[ihandler]}
        # Cannot use qbug here
        qprint "qTrapHandler: Calling handler: $handler"
        $handler || true   # call the handler, ignore errors
    done
    qtrap=y    # So qTrapDisable will work for sure
    qTrapDisable  # don't trap again... can cause unwanted recursion
    # Not all traps are certain death, but most of them are (in bash).
    # For consistency, exit here.
    qprint "$qPretty_red""TRAPPED EXCEPTION! Goodbye!""$qPretty_off"
    exit 1
}

##############################################################################
# qTrapEnable -- enable standard exception handling (if $qtrap = y)
#
#       Most likely this should be called only within qlib?
##############################################################################
qTrapEnable()
{
    # Trap exceptions
    if test "$qtrap" = y ; then
        trap 'qTrapHandler' EXIT HUP TERM INT QUIT ABRT ALRM
    fi 
    return 0
}


##############################################################################
# qTrapDisable -- disable standard exception handling (if $qtrap = y)
#
#       Most likely this should be called only within qlib?
##############################################################################
qTrapDisable()
{
    if test "$qtrap" = y ; then
        # Removes traps
        trap '-' EXIT HUP TERM INT QUIT ABRT ALRM
    fi
    return 0
}


##############################################################################
# qStart [<cmd> [<arg>...]]
#       Call from end of each script file to possibly start things running.
#       Do NOT call otherwise; this works only as the most top level
#       function of your program, apart from minor initializations.
#
#       With no arguments, treated as if <cmd> is '-'
#       <cmd> is one of:
#               '-' (a hyphen)  -- if <arg>... provided, pass to qrun
#                       else enter debugger.
#               a command to Be passed to qrun, which can be any
#                       function, shell builtin or program.
#                       It could even be:  eval "bash script"
# 
# qStart detects whether the file it is called from was the orginal file
# invoked by bash, and if so it executes the given command.
##############################################################################
qStartOnce=n    # detect unwanted recursion
qStart()
{
    # Save state, get arguments, check if we should run...
    local save_qbp="$qbp" ; qbp=n  # will be restored
    qEnter "$@"  # our standard way to begin a function
    local cmd
    if test -v 1 ; then cmd="$1" ; shift 
    else cmd='-'   # see special treatment below
    fi
    local currentFile=${BASH_SOURCE[0]}   # file we are in now
    local fromFile=${BASH_SOURCE[1]}   # who called us
    local depth
    for depth in ${!BASH_SOURCE[@]} ; do
        true
    done
    local firstFile=${BASH_SOURCE[$depth]}
    if test "$fromFile" != "$firstFile" ; then
        qbug "Skipping... Called from $fromFile instead of $firstFile"
        qReturnOk 
        qbp="$save_qbp"   # restore
        return 0
    fi
    if test "$qStartOnce" = y ; then   # shouldnt happen?
        qReturnFail "Ignoring redundant qStart call"
        qbp="$save_qbp"   # restore
        return 0
    fi

    # Here we really should run
    qStartOnce=y
    qbug "Called from original start file $firstFile -- really start!"

    # Breakpoint stuff initialization
    # Set the base. Start with the caller of qStart, 
    # since line numbers in qStart will vary depending on options.
    qBackTrace start=1 style=bpath ; qbreakpath_base="$qbt_result"
    qbpath_ilatest=0 
    qbpath_latest="$qbreakpath_base"
    qbpath_lookup=( )
    qbpath_lookup[$qbreakpath_base]=0
    qbpath_table=( )
    qbpath_table[0]='y'
    qbpath_reverse=( )
    qbpath_reverse[0]="$qbreakpath_base"
    qbpath_inext=1

    qBackTrace start=1 style=bpoint ; qbpoint_latest="$qbt_result"
    qbpoint_ilatest=0 
    qbpoint_lookup=( )
    qbpoint_lookup[$qbpoint_latest]=0
    qbpoint_table=( )
    qbpoint_table[0]='y'
    qbpoint_reverse=( )
    qbpoint_reverse[0]="$qbpoint_latest"
    qbpoint_inext=1

    qbpoint_isinit=y    # allow breakpoints to work now

    qTrapEnable    # turn on traps on exceptions, if enabled

    qbp="$save_qbp"   # restore
    if test "$cmd" = '-' ; then
        # Using '-' instead of command means one of two things:
        #       With no args, enter debugger
        #       With args, they are passed to qrun as a command;
        #       ... very useful for debugging individual functions
        #       ... without having to write a test script to do it.
        local qd_interactive=n
        # LOW LEVEL, do not call qEnter or qReturnOk if we will be interactive
        if test $# = 0 ; then
            # Interactive
            qd_interactive=y
            # Note qDebuggerI will call qTrapEnable when appropriate.
            qDebuggerI
            while true ; do
                qprint ; qprint ; qprint 
                qprint "qStart: LAST CHANCE... Use q to quit program" 
                qDebuggerI
            done
        else
            if qrun "$@" ; then
                qbug "SUCCESS: $@"
            else
                qerror FAILED "$@" 
                qresult=''
            fi
        fi
    else
        # Here executed the command passed to us, using qrun.
        # This will typically be a function that implements the functionality
        # of the program.
        test "$qbpq" = y && qbreakpoint  # possible breakpoint
        qTrapEnable        # possibly trap exceptions
        if ! qrun "$cmd" $@ ; then      # run the command
            qTrapDisable
            test "$qbpq" = y && qbreakpoint  # possible breakpoint
            # NOTE: qrun already printed error message about command failure.
            save_qbp="$qbp" ; local qbp=n  # will be restored
            qReturnFail "FAILED - Goodbye!"
            qbp="$save_qbp"   # restore
            while test "$qbp" = y ; do  # auto-breakpoint
                qprint ; qprint; qprint
                qprint "LOWEST LEVEL... Use q to quit program"
                qDebuggerI
            done
            return 1
        else
            qTrapDisable
            qbug "SUCCESS: $cmd $@"
        fi
    fi
    save_qbp="$qbp" ; local qbp=n  # will be restored
    # Feature: print any unhandled result to stdout
    # In theory this can allow external programs to invoke us as:
    #   result=$(thisprogram args)
    # Since qlib is careful to emit all messages to stderr, 
    # except as return values in some cases, stdout is a clear channel
    # for returning values.
    if test -n "$qresult" ; then
        echo $qresult
        qresult=''
    fi

    # We really are supposed to be the last thing. So exit now.
    qTrapDisable        # just in case
    exit 0

    # If we didn't exit above, then proceed...
    # but there would need to be more cleanup code.
    qReturnOk 
    qbp="$save_qbp"   # restore
}


# For unit testing, we are done!
if test "$qUnitTest" = y ; then echo; echo "UNIT TESTS DONE; Goodbye." ; exit 0; fi
