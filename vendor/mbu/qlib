##############################################################################
# qbptPathsEdit -- interactive editing of commands per breakpath
##############################################################################
qbptPathsEdit()
{
    qEnter "$@"  # our standard way to begin a function
    # Show user the table:
    qbptPathsList
    qprintf "%s" "CURRENT is #$qbpath_ilatest : ${qbpath_reverse[$qbpath_ilatest]}"
    qprintf " %s\n" "... cmd=[${qbpath_table[$qbpath_ilatest]}]"
    qUserRead promptbase="Enter Index (default current):" defaultvalue="$qbpath_ilatest"
    local itable="$qresult"
    # TODO: use routine for checking for non-negative integer input
    if ! expr "$itable" + 1 >/dev/null 2>/dev/null ; then
        qerror "Ignoring non-numeric input: $itable" ; qReturnOk ; return 0
    fi
    if test ! -v qbpath_table[$itable] ; then
        qerror "Ignoring Invalid index: $itable" ; qReturnOk ; return 0
    fi
    local command=${qbpath_table[$itable]}
    local path=${qbpath_reverse[$itable]}
    # show user that table entry
    qprintf "%s" "SELECTED is #$itable : $path"
    qprintf " %s\n" "... cmd=[$command]"
    qUserRead promptbase="Enter New Command: [$command]"
    local command="$qresult"
    if test -n "$command" ; then
        case "$command" in
            y|'y '*) true ;;
            n|'n '*) true ;;
            *) qReturnFail "Command must start with y or n to enable/disable"
                return 1
            ;;
        esac
        qbpath_table[$itable]="$command"
        qprintf "%s" "SET #$itable : ${qbpath_reverse[$itable]}"
        qprintf " %s\n" "TO cmd=[${qbpath_table[$itable]}]"
    else
        true
        qprintf "%s" "UNCHANGED #$itable : ${qbpath_reverse[$itable]}"
        qprintf " %s\n" "IS cmd=[${qbpath_table[$itable]}]"
    fi

    qReturnOk ; return 0
}

