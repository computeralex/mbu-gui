##############################################################################
# qVarRead [r=<output-varname>] <varname> -- safely read a variable by name.
#       Well, safety is relative; but this catches some important failures.
#
#       Options are:
#               r=<output-varname>  -- save result via output-varname
#               fail={y|n}  -- if y, return 1 on error (default is n)
#
#       Return status:
#               By default, always 0
#               with fail=y, nonzero if a failure, else 0
#
#       Return value is the value read from <varname>
#               Is returned via <output-varname>, or by qresult.
#
#       On failure, qresult is null and <output-varname>, if given, 
#       may or may not have the correct result.
#
#       Fails if <varname> is not valid for a variable name, or if
#       no variable by that name is "set" ... variables are set when 
#       assigned a value, but can also be unset.
#       May also fail if <output-name> is not a legal variable name.
#
#       For arrays, the (constant) subscript is part of the name,
#               e.g. a[1] is a valid name but a[$n] is not.
#       All should well if you call qVarRead as:
#               qVarRead "a[$n]" 
#       instead of 
#               qVarRead 'a[$n]'
#       provided of course that $n evaluates appropriately.
#
#       Typical usage:
#               local myresult='some default'
#               qVarRead r=myresult varname
#       Where more error checking is needed:
#               if ! qVarRead fail=y varname ; then return error ; fi
#               qResult myresult
#       The following does a little less checking but may be preferred:
#               local myresult='some default'
#               if ! test -v "$varname" ; then  return error ; fi
#               qVarRead varname ; myresult="$qresult"
##############################################################################
qVarRead()
{
    qresult=''    # ensure empty output is the default
    local qVarRead_outvarname=''        # where to output
    local qVarRead_fail=''              # fail on error?
    local qVarRead_failed=n             # did we fail?
    local qVarRead_result=''            # our result
    while test $# -gt 0 ; do
        case "$1" in 
            r=*) 
                qVarRead_outvarname=${1#r=}
                shift
            ;;
            fail=*)
                qVarRead_fail=${1#fail=}
            ;;
            *=*) 
                qVarRead_failed=y
                shift           # keep going and hope for the best
            ;;
            *)
                break
            ;;
        esac
    done
    local qVarRead_varname="${1:-}"      # Name of variable (default no name)
    # "test -v" will fail if $varname is an invalid variable name
    # or if the variable is not "set" meaning it has never been assigned
    # a value... something of a test of existence.
    if test -v "$qVarRead_varname" ; then
        qVarRead_result="${!qVarRead_varname}"
    else
        qVarRead_failed=y
    fi
    # Return result via output variable name
    if ! test -z "$qVarRead_outvarname" ; then
        if ! printf -v "$qVarRead_outvarname" "$s" "$qVarRead_result" ; then
            qVarRead_failed=y
        fi
    else
        # Return result via qresult
        qresult="$qVarRead_result"
    fi
    if test "$qVarRead_fail" = y ; then
        if test "$qVarRead_failed" = y ; then
            return 1
        fi
    fi
    return 0
}



##############################################################################
# qCallDepthMake -- generate a string for diagnostics showing call depth
#       Return result is in global variable qcdepth
##############################################################################
qcdepth=''
qCallDepthMake()
{
    # Low level function, do NOT use qEnter

    # CAUTION give unique names for all local variables in order to
    # preserve ability to see local variables in call stack!

    qcdepth=''
    local qcdm_depth
    for qcdm_depth in ${!BASH_SOURCE[@]} ; do
        qcdepth+='+'
    done

    # Low level function, do NOT use qReturnOk
    return 0
}

##############################################################################
# qEnter -- put at top of function body to do standard function entry
#       Clears qresult.
#       Conditional on qbug, command and args are displayed
##############################################################################
qEnter()
{
    # Low level function, do NOT call qEnter or qReturnOk
    # CAUTION give unique names for all local variables in order to
    # preserve ability to see local variables in call stack!

    qresult=''        # clear output result, just in case
    local qenter_fncname=${FUNCNAME[1]}  # 1 for caller function name
    if test "$qbug" = y ; then
        qCallDepthMake ; local qenter_depthmsg="$qcdepth"
        qDiagnostic Enter "$qenter_depthmsg" "$qenter_fncname" "$*"
    fi
    test "$qbpq" = y && qbreakpoint  # possible breakpoint
    return 0
}


##############################################################################
# qReturnOk [<result>] -- save return result in qresult. Returns 0 status.
#       If no <result> passed, then qresult is set to the empty string.
#       To pass a previous result, do it explicitly!
#
#       Use as: 
#               qReturnOk result-value ; return 0
#
#       BE SURE to call: return 0
#       immediately after calling this... sorry, there is no way to do that
#       automatically.
#
#       Tests qbug for diagnotic message.
##############################################################################
qReturnOk()
{
    # Low level function, do NOT call qEnter or qReturnOk
    # CAUTION give unique names for all local variables in order to
    # preserve ability to see local variables in call stack!

    if test "$qbug" = y ; then
        qCallDepthMake ; local depthmsg="$qcdepth"
        qDiagnostic DoneOk "$depthmsg $*"
    fi
    qresult="$*"      # set result
    test "$qbpq" = y && qbreakpoint  # possible breakpoint
    return 0
}


##############################################################################
# qReturnFail [<msg>] -- Clear qresult, return 0.
#       Tests qerror. Args are for diagnostic message.
#       Use as: qReturnFail message ; return 1
#
#       BE SURE to call: return 1
#       immediately after calling this... sorry, there is no way to do that
#       automatically.
#
#       NOTE: It is allowed to pass a result anyway:
#               qReturnFail mymsg  ; qresult=myvalue ; return 1
##############################################################################
qReturnFail()
{
    # Low level function, do NOT call qEnter or qReturnOk
    # CAUTION give unique names for all local variables in order to
    # preserve ability to see local variables in call stack!

    if test "$qerror" = y ; then
        qCallDepthMake ; local depthmsg="$qcdepth"
        qDiagnostic FAIL "$depthmsg $*"
    fi
    qresult=''    # clear global variable holding result, for consistency
    test "$qbpq" = y && qbreakpoint  # possible breakpoint
    return 0
}


##############################################################################
# qResult [<varname>] - 
#               Returns or echoes the value of qresult as set with qReturnOk.
#
#       With <varname>, the value is placed into the variable named <varname>.
#       and qresult is cleared for future sanity.
#       Adds debugging (when qbug is 'y').
#       Use as:  qResult myvar
#
#       With no argument, echoes $qresult to stdout.
#       Use as:  foo="$(qResult)"  -- immediately after call that sets it!
#       This is functionally the same as foo="$qresult"
#       but adds debugging (when qbug is 'y').
#       Clearing of qresult does not work because $(qResult) runs in
#       a child process, and clearing qresult here has no practical effect.
#
# Notes:
#       The use of qrun -r<varname> is generally preferred to this.
##############################################################################
qResult()
{
    # Low level function, do NOT call qEnter or qReturnOk
    # CAUTION give unique names for all local variables in order to
    # preserve ability to see local variables in call stack!

    local qr_result="$qresult"     # get the global/inherited result value
    local qr_msg="$qr_result"      # for diagnostics
    if test -z "$qr_msg" ; then qr_msg='(EmptyResult)' ; fi
    if test "$qbug" = y ; then
        qDiagnostic Result "$qr_msg"
    fi
    qresult=''     # NOTE doesn't work from child process, e.g. $(qResult)
    if test -n "${1:-}" ; then  # variable name passed
        printf -v "$1" "%s" "$qr_result"
    else
        echo "$qr_result"
    fi
    return 0
}



##############################################################################
# qrun [<option>]... [<cmd> <arg>...]   -- run a simple command with retries/logging
#       If command exits with non-zero (error) status, it is retried
#       until the maximum tries is reached (default only once)
#       The command is always executed at least once; default n. of retries is 0
#       The execution of the command is presented as a status or debug message.
#       The command is not executed at all if qdryrun is y.
#       A missing or empty command does nothing successfully.
#       Otherwise the return status is the return status of the command.
#       If r=<varname> is provided, returns result (qresult) via <varname>
#       and clears qresult for sanity.
#
#       This is basically just
#               "$@"
#       but adds debugging, retries, qresult return to variable, and other
#       features.
#
#       qrun is particularly appropriate for commmands that have system impact 
#       and thus we should be verbose about, or where retries are needed.
#
#       <option> can be:
#            =   -- just an equal sign to terminate options 
#                   Useful if first word of command might have an equal sign in it.
#            r=<varname> -- return result ($qresult) into $varname (if successful).
#            p={y|n}   -- y to print output of qrun to stdout 
#                       instead of returning via result.
#            retries=<nretries>  -- how many retries (integer)
#            diag={quser|qbug}  -- where to send diagnostics (default qbug)
#            read={y|n}   -- y to run cmd in subshell and read it's output 
#                               (instead of it returning result via qresult)
#       <cmd> with <arg>... are executed as a simple command
#       Return is 0 if successful (perhaps due to retries),
#               1 if unsuccessful.
#       Return value via qresult (or to stdout with p=y).
#
# Notes: r= and p= should probably not both be used together ???
##############################################################################
qrun()
{
    qEnter "$@"  # our standard way to begin a function
    # CAUTION! BECAUSE we offer the option to store the result via a variable name,
    # we MUST be extra careful to avoid any shadowing of a variable name by a local
    # variable!!!!!!! Thus all local variables here are named in a unique way
    # by beginning with qrun_  .
    local qrun_result=''     # our output

    # Get options
    local qrun_options=''
    local qrun_varname='' ; qrun_options+='r:qrun_varname,'
    local qrun_retries=0  ; qrun_options+='retries:qrun_retries,'
    local qrun_statusfnc=qbug ; qrun_options+='diag:qrun_statusfnc,'   # Default, not verbose
    local qrun_read=n ; qrun_options+='read:qrun_read,'    # y to read stdout of the command 
    local qrun_p=n ; qrun_options+='p:qrun_p'     # y to write result to stdout
    qOption "$qrun_options" "$@"  ; shift $qresult

    # Option sanity checks
    if test "$qrun_varname" = y && test "$qrun_p" = y ; then
        qrunFail "Incompatible output options" ; return 1
    fi
    # Optional sanity check on qrun_statusfnc
    #   we should probably trust anything given us... ?
    case "$qrun_statusfnc" in
        'qbug') true ;;
        'quser') true ;;
        *)  #
            qerror "Ignoring unsupported diag type: $qrun_statusfnc"
            qrun_statusfnc='qbug'   # fix bad input
        ;;
    esac

    # Retry loop:
    local qrun_maxtries=$((qrun_retries + 1))
    local qrun_tries=1
    while true ; do
        if test "$qdryrun" = y ; then     # for debugging
            $qrun_statusfnc "PRETENDING WE EXECUTED: $*"
            break
        fi
        if test "$qrun_maxtries" -gt 1 ; then
            $qrun_statusfnc "Try $qrun_tries/$qrun_maxtries for: $*"
        else
            $qrun_statusfnc "::: $*"
        fi
        if test "$qrun_read" = y ; then
            # Here we run the command and read it's stdout
            # It is run in subshell which has some issues... not recommended?
            qrun_result=$( $@ )
            if test "$?" = 0 ; then
                break
            fi
        else
            # Here we run the command directly, with return value by qresult
            if "$@" ; then
                qResult qrun_result
                break
            fi
        fi
        # Here on failure
        if test $qrun_tries -ge $qrun_maxtries  ; then
            if test "$qrun_maxtries" -gt 1 ; then
                qReturnFail "Too many retries for: $*"
            else
                qReturnFail "Command failed: $*"
            fi
            return 1
        fi
        $qrun_statusfnc "Will RETRY. Did $qrun_tries/$qrun_maxtries tries for: $*"
        qrun_tries=$(($qrun_tries+1))
    done
    qbug "Finished OK: $*"

    if test -n "$qrun_varname" ; then 
        qbug "Storing RESULT in variable r=$qrun_varname : $qrun_result"
        printf -v $qrun_varname "%s" "$qrun_result" 
        qrun_result=''
    elif test "$qrun_p" = y ; then 
        qbug "Echoing RESULT : $qrun_result"
        echo "$qrun_result" 
        qrun_result=''
    fi
    if test -n "$qrun_result" ; then 
        qbug "Returning non-empty qresult : $qrun_result"
    fi
    qReturnOk "$qrun_result" ; return 0
}
# Unit test for qrun, qReturnOk, qReturnFail, qResult, 
#       quser, qbug, qerror etc.
