##############################################################################
# qOptionParse <option> -- parse an option string.
#               Option string might have form <key>=<value>
#       <option>  -- the string to be parsed
#
# NOTE: qOption is a better choice, although a little more limited.
#
#   Returns results in global/inherited variables:
#       qooption -- copy of the input
#       qokey -- parsed key (may be empty string)
#       qovalue -- parsed value (may be entire input if no key= part)
# It is strongly advised to quickly save these values in local variables
# to avoid conflict with subsequent calls to qOptionParse OR
# to declare qooption, qokey, qovalue to be local!
#
# Case 1: If option is not passed, key and value are empty.
# Case 2: <option> does not contain an equal sign, or begins with an equal sign:
#       The value is <option> and the <key> is empty.
# Case 3: <option> contains an equal sign (and does not begin with one):
#       The string before the (1st) equal sign is the key (not empty),  
#       the string after the (1st) equal sign is the value (might be empty),
#       and the equal sign is omitted from both key and value.
#
# Returns 0 in all cases, so you never need to check the return value.
#
# Recommended best practice 1:
#       local qooption ; local qokey; local qovalue # variables of qOptionParse
#       while test $# -gt 0 ; do
#           qOptionParse "$1" ; shift
#           if test "$qooption" = '=' ; then break; fi # positional params follow
#           case "$qokey" in
#               '') # no key
#                   do domething with "$qooption"
#               ;;
#               somethingelse)
#                   do something with "$qovalue"
#               ;;
#           esac
#       done
#       handle positional arguments here
# Recommended best practice 2:
#       while test $# -gt 0 ; do
#           local option="$1" ; shift
#           if test "$option" = '=' ; then break; fi # positional params follow
#           qOptionParse "$option"; local key="$qokey"; local value="$qovalue"
#           case "$key" in
#               '') # no key
#                   do domething with $option
#               ;;
#               somethingelse)
#                   do something with $value
#               ;;
#           esac
#       done
#       handle positional arguments here
#       
##############################################################################
qooption=''     # input to qOptionParse remembered here
qokey=''        # output from qOptionParse here
qovalue=''        # output from qOptionParse here
qOptionParse()
{
    # Low level function, do NOT use qEnter

    # CAUTION give unique names for all local variables in order to
    # preserve ability to see local variables in call stack!
    shopt -s extglob     # Turn on extended features - should always be on!

    # Work directly into our output global/inherited variables
    qooption=${1:-}   # copy input to qooption
    qokey=''    # default no key
    qovalue=''  # deafult no value
    # Now parse it
    case "$qooption" in
        =*)     # Null key, entire input is the value
            qovalue="$qooption"
        ;;
        *=*)    # Full key=value form
            qokey=${qooption//=+(?)}
            qovalue=${qooption/+([^=])=}
        ;;
        *)  # Missing equal sign, treat as null key with input as value
            qovalue="$qooption"  
        ;;
    esac
    # Low levelf unction, do NOT use qReturnOk
    return 0
}
qOptionParse_UnitTest()
{
    echo "qOptionParse Unit Tests"
    local qokey; local qovalue;   # required for qOptionParse
    local option="foo=bar=wow=how" ; qOptionParse "$option" 
    echo "TESTED: OPTION $option -> KEY $qokey VALUE $qovalue"
    local option="foo=bar" ; qOptionParse "$option" 
    echo "TESTED: OPTION $option -> KEY $qokey VALUE $qovalue"
    local option="foo=" ; qOptionParse "$option" 
    echo "TESTED: OPTION $option -> KEY $qokey VALUE $qovalue"
    local option="foo" ; qOptionParse "$option" 
    echo "TESTED: OPTION $option -> KEY $qokey VALUE $qovalue"
    local option="=" ; qOptionParse "$option" 
    echo "TESTED: OPTION $option -> KEY $qokey VALUE $qovalue"
    local option="=bar" ; qOptionParse "$option" 
    echo "TESTED: OPTION $option -> KEY $qokey VALUE $qovalue"
    local option="" ; qOptionParse "$option" 
    echo "TESTED: OPTION $option -> KEY $qokey VALUE $qovalue"
    echo
    return 0
}
if test "$qUnitTest" = y ; then qOptionParse_UnitTest ; fi




##############################################################################
# qOption <speclist> [<arg>]...  -- get multiple optional arguments.
#       qOption handles optional parameters passed to your bash function.
#       Optional parameters are parameters that may be given in any order,
#       and are typically entirely before any positional parameters.
#       qOption handles the arguments <arg>, using instructions from
#       <speclist> until it finds an argument that it doesn't know what to
#       do with, or it runs out of arguments.
#       qOption returns status 0 and never knowingly generates an error
#       or emits any error messages.
#       qOption returns via qresult the number of arguments consumed, and the
#       caller should typically shift arguments accordingly, checking if any left.
#       Based on <speclist>, qOption tries to return the parameters values
#       directly into the variables of the caller, which are passed by name.
#
#       If you are having trouble undestanding qOption failures, trying setting
#               qobug=y
#       first to get debugging messages for qOption
#
#       [<arg>]...    is most commonly in the form of "$@" to pass all 
#       remaining args from the caller.
#
#       <speclist> is a single argument with commas (more readable?) or spaces 
#       separating the components called <spec>, e.g.
#               <spec>,<spec>,<spec>    for example.
#       Extraneous commas or spaces are ignored.
#       It would probably be a good idea to quote <speclist>... just in case?
#
#       There are a few special values of <spec> that simply alter the behavior
#       of qOption, if seen anywhere in the <speclist>:
#               QOIGNORE -- continue until an arg beginning with '=' is found
#                       or the end of the <arg>s is reached, instead of
#                       aborting on unmatched args.
#       Otherwise,
#       the format of <spec> is (examples below may make this more clear):
#               <spec> ::= <key>[:<varname>][{=<altvalue>}|?}
#       <key> is a non-empty word consisting of letters, digits, underscores,
#               and certain punctuation characters allowed including hyphens;
#               it is not advised to all punctuation other than hyphens
#               and see below about <varname>.
#       <varname> (note, preceded by colon) 
#               is (optional) the actual name of your variable to assign to.
#               Of course it must follow bash rules for variable names.
#               You MUST provide a <varname> if the <key> differs from the
#               name of the variable to assign to.
#       <altvalue> (note, preceded by equal sign) is the value to use 
#               ONLY for the "unvalued" case (see below); ignored otherwise.
#               <altvalue> may not contain a question mark or an equal sign.
#       (Only if no =<altvalue>, see above): A question mark (?) at the end 
#               of <spec> indicates that the value is to be obtained from 
#               another argument, ONLY for the "unvalued" case (see below),
#               ignored otherwise.
#               The content of the additional argument can be anything.
#               NOTE: This is fundamentally incompatible with QOIGNORE.
#
#       About output variable names (from <varname> or implied by <key>):
#       As usual, be hyper-vigilant not to unwittingly trash 
#       the variables of functions lower down in the variable stack.
#       [Do not use variable names that would conflict with qOption
#       local variables, all of which begin with "qo".]
#
#       qOption is entirely driven by the <arg> stream and does not,
#       for example, care if any <spec> were unmatched.
#       You should assign your variables default values in case the
#       caller of your function did not give options to set them.
#
#       qOption classifies each <arg> into one of 3 classes to obtain a value:
#       (1) Any argument beginning with an equal sign (=) immediately
#           ends processing, without eating the argument (incrementing the count).
#       (2) An argument <arg> NOT containing an equal sign is considered 
#           an "unvalued" argument.
#           If <arg> exactly matches a <key> in a <spec> then a match is found.
#           If a match is found, then the value is obtained from an <altvalue>
#           if provided, or from an additional <arg> if the (?) form is used.
#           The additional <arg> can be anything, but if no additional
#           arguments are available then an empty string is substituted.
#           If no match is found, then qOption terminates without eating 
#           the argument (adding to the count).
#           If no value is found (i.e. no =<altvalue> or ?) then 
#           qOption also terminates without eating the argument.
#           EXAMPLE: if matching <spec> was just "foo" and <arg> was "foo"
#           there will be no match and processing will terminate;
#           but if the <spec> was foo=<altvalue> then a match occurs and
#           the resulting value will be <altvalue>.
#       (3) An argument matching the general form 
#                   <key>=<value>
#           where <key> is subject to the same restrictions as for <spec>
#           and <value> may contain ALMOST anything including being empty
#           or containing an equal sign (<key>= stops at the first =),
#           spaces or other punctuation (implemenation: must not contain ;).
#           This is a "valued" option.
#           If the <key> matches a <key> in a <spec>, then a match is found
#           and the value is <value>.
#           If no match is found, then qOption terminates without eating 
#           the argument (adding to the count).
#           
#       As indicated above, if no match or no value is found, then qOption 
#       terminates, returning the count of consumed arguments.
#       Otherwise, the next step in the processing of the argument <arg>
#       is to save the value in your variable according to the match.
#       If <varname> was provided in the matched <spec>, then it was used.
#       Otherwise, <key> is used as the name of your variable.
#       Make SURE that your real variable name is so specified!
#       The value is then stored into the named variable.
#
# Example:
#   myHelp="xxx yyy"
#   myFunc() {
#       local foo=baz ; local bar=''; local help=n 
#       qOption 'foo,bar,help=y,-help:help=y,--help:help=y' "$@" ; shift $qresult
#       # Check for positional args.
#       if $# -gt 0 ; then qReturnFail "Invalid arg: $1" ; return 1 ; fi
#       if test "$help" = y ; then echo $myHelp ; echo ; return 0 ; fi
#       case "$foo" in
#               baz) doSomething ; ;;
#               *) qReturnFail "Invalid option: foo=$foo" ; return 1 ; ;;
#       esac
#       ... etc ..
#
# In this example (with -help- in optionlist), the following invocations:
#       myFunc help
#       myFunc -help
#       myFunc --help
#       myFunc help=y
#       myFunc -help=y
#               (and etc.) will all print the help message
#       myFunc foo=baz
#               will call doSomething
#       myFunc foo=somethingelse
#               will return with an error
#       
#
# NOTES:
#       Failing to pre-declare your variables as "local" can result in
#       clobbering the (supposed to be) local variables of the caller.
#       Make sure that either each <key> in your <spec>s are actual
#       variable names of yours, or you provide a proper <varname>.
#
#       Normally for each option name <name> you would have a preceding
#       statement to give it a default value:
#               local help=n
#               local foo=baz
#               local bar=''
#       But it is also possible to leave it unset, and then later test it,
#               local bar
#               qOption...
#               if test ! -v bar ; then 
#                       qReturnFail "Option bar is mandatory" ; return 1 ; fi
#
##############################################################################
: ${qobug:=n}    # enable debugs in qOption. need qbug=y to see them.
qOption()
{
    # Low Level, don't call qEnter or qReturnOk

    # CAUTION give unique names for all local variables in order to
    # preserve ability to see local variables in call stack!

    # Special support for debugging
    local qbug="$qbug"  # so we can modify temporarily
    if test "$qobug" = y ; then qbug=y ; fi  # so we see debug messages

    shopt -s extglob     # Turn on extended features - should always be on!

    # Arrays to hold <spec> info, all indexed by <key>
    local -A qoaddarg_a=( )       # additional arg needed?
    local -A qohavealt_a=( )      # alternate value in spec?
    local -A qoaltvalue_a=( )     # value of altvalue if present
    local -A qovarname_a=( )      # the variable name

    # Options for our own behavior:
    local qoignore=n            # dont stop on unmatched

    # Get <speclist>
    if test $# = 0 ; then qresult=0 ; return 0; fi       # sanity
    local qospecs="$1" ; shift

    # Remember where we started so we can return how many <arg> consumed
    local qoargc_start="$#"

    # Unpack the <speclist> into <spec>s
    # Convert commas to spaces 
    #was# and put protection for bash "for" command.
    #was# The protection consists of single quotes around each spec that will 
    #was#   have to be removed below.
    qospecs=${qospecs//,/ }     # convert commas to spaces
    qospecs=${qospecs//+( )/ }  # convert multiple spaces to one
    qospecs=${qospecs## }       # remove leading spaces
    qospecs=${qospecs%% }       # remove trailing spaces
    #was# qospecs=${qospecs// /\' \') # make spaces be spaces
    #was# qospecs=\'$qospecs\'        # provide leading/trailing quotes
    local qospec
    # Use bash to expand into words, but UGH this may run into 
    # metacharacter problems if random characters are passed us...
    # but that shouldnt happen at least for the option spec
    for qospec in $qospecs ; do
        #was# # Remove extra single quotes introduced above for protection
        #was# qospec="${qospec#\'}"
        #was# qospec="${qospec%\'}"
        local qospec_original="$qospec"  # for diagnostics.
        # Special values of <spec>
        case "$qospec" in
            QOIGNORE) 
                test "$qobug" = y && qbug "Honoring QOIGNORE"
                qoignore=y 
            continue ;;
        esac
        # Parse the spec
        local qoaddarg=n        # additional arg needed?
        local qohavealt=n       # alternate value in spec?
        local qoaltvalue=''     # value of altvalue if present
        local qovarname=''      # the variable name
        local qokey=''          # option key
        case "$qospec" in
            *=*) # inline arg for unvalued options
                qohavealt=y
                qoaddarg=n      # incompatible 
                qoaltvalue=${qospec##+([^=])=}
                qospec=${qospec%=+([^=])}
            ;;
            *'?')  # additional arg needed, for unvalued options
                qoaddarg=y 
                qhavealt=n  # incompatible
                qospec=${qospec%?}      # remove last character
            ;;
        esac
        case "$qospec" in
            *:*) 
                # Extra variable name fro the spec
                qovarname=${qospec//+([^:]):}
                qospec=${qospec//:+([^:])}
            ;;
        esac
        qokey="$qospec"         # all that is left of the spec
        if test -z "$qokey" ; then 
            test "$qobug" = y && qbug
            continue            # shouldnt happen?
        fi
        # Fix variable name
        if test -z "$qovarname" ; then
            qovarname="$qokey"  # variable name must be same as key
        fi
        # now we definitely have variable name, hopefully a good one
        #  store into arrays
        test "$qobug" = y && qbug "Remembering key $qokey from spec $qospec_original havealt=$qohavealt altvalue=$qoaltvalue varname=$qovarname"
        qoaddarg_a["$qokey"]="$qoaddarg"
        qohavealt_a["$qokey"]="$qohavealt"
        qoaltvalue_a["$qokey"]="$qoaltvalue"
        qovarname_a["$qokey"]="$qovarname"
    done

    # Now process the args
    while test $# -gt 0 ; do
        local qoarg="$1"
        local qo_valued    # y for <key>=<value> else no
        local qokey=''
        local qovalue=''
        test "$qobug" = y && qbug "Arg: Next arg: $qoarg"
        # Which of the basic 3 classes of args?
        case "$qoarg" in
            =*) qo_valued=n     # an empty key doesn't count
                # This is used as an "end of options" option.
                test "$qobug" = y && qbug "Arg: Begins with = : $qoarg"
                break   # terminate processing.
            ;;
            *=*) qo_valued=y
                test "$qobug" = y && qbug "Arg: key=val form: $qoarg"
            ;;
            *) qo_valued=n
                test "$qobug" = y && qbug "Arg: NOT key=val form: $qoarg"
            ;;
        esac
        if test "$qo_valued" = y ; then
            # here if arg is of form <key>=<value (<value may be empty)
            qokey=${qoarg%%=*([^=])}
            qovalue=${qoarg#*([^=])=}
        else
            qokey="$qoarg"   # make the entire argument be the key, w/ no value
            qovalue=''
        fi
        # Find matching <spec>  (can check any array so long as result should be non-empty)
        qokey="$qokey"
        local qovarname=${qovarname_a["$qokey"]:-}
        if test -z "$qovarname" ; then
            test "$qobug" = y && qbug "Arg: key not found: $qoarg"
            if test "$qoignore" = y ; then shift ; continue ; fi
            test "$qobug" = y && qbug "Arg: aborting at: $qoarg"
            break       # no match.. abort.. don't shift!
        fi
        # Here key is a match ... get rest of the spec for it
        local qoaddarg=${qoaddarg_a["$qokey"]}
        local qohavealt=${qohavealt_a["$qokey"]}
        local qoaltvalue=${qoaltvalue_a["$qokey"]}
        # Do we have a value?
        if test "$qo_valued" = n ; then
            if test "$qoaddarg" = y ; then
                test "$qobug" = y && qbug "Arg: another arg needed for value: $qoarg"
                shift           # eat the arg
                qovalue=''
                if test $# -gt 0 ; then
                    qovalue="$1" ; shift
                else
                    test "$qobug" = y && qbug "Arg: another arg not found for: $qoarg"
                fi
            elif test "$qohavealt" = y ; then
                shift           # eat the arg
                qovalue="$qoaltvalue"
            else
                # NO value... abort
                test "$qobug" = y && qbug "Arg: not value determined for: $qoarg"
                if test "$qoignore" = y ; then shift ; continue ; fi
                test "$qobug" = y && qbug "Arg: aborting at: $qoarg"
                break   # don't shift
            fi
        else    # key=value
            # we got the value already
            shift           # eat the arg
        fi
        # Now store in location
        test "$qobug" = y && qbug "Arg: storing value [$qovalue] in variable $qovarname at: $qoarg"
        printf -v "$qovarname" "%s" "$qovalue"
    done

    # Return number of args consumed via qresult
    local qoargc_end="$#"
    local qoresult=$((qoargc_start - qoargc_end))
    test "$qobug" = y && qbug "Returning nargs we ate: $qoresult"

    # Never fail, just screw up?
    qresult="$qoresult"
    return 0
}
qOption_UnitTest()
{
    echo qOption TEST 1
    qresult=''
    local aa=1 bb=2 cc=3 dd=4
    qOption '-ff:bb=5,aa?,cc,dodo:dd=why?' dodo -ff aa 7 cc=6 
    echo "VALUES   qresult=$qresult aa=$aa bb=$bb cc=$cc dd=$dd"
    if test "$qresult" = 5 && test "$aa" = 7 && test "$bb" = 5 && 
                test "$cc" = 6 && test "$dd" = 'why?' ; then echo PASS
    else echo FAIL ; fi 

    echo qOption TEST 2
