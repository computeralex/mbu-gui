##############################################################################
# foobarWidgetsMake -- example subroutine
#       Options:
#           maxwidgets=  max number of widgets to use
#           maxsize=  limit to size of each widget
#           o=  output file path
#       Return value on success:
#           The actual filepath used
##############################################################################
foobarWidgetsMake()
{
    qEnter "$@"  # our standard way to begin a function
    local default_filepath='./widgets'
    local filepath="$default_filepath"
    local maxwidgets=33
    local maxsize=100
    qOption 'o:filepath,maxwidgets,maxsize,'  "$@"
    shift $qresult
    if test $# -gt 0 ; then qReturnFail "Extra args: $@" ; return 1; fi
    if test -z "$filepath" ; then 
        filepath="$default_filepath" 
        qbug "Substituting default filepath $filepath"
    fi
    # echo "WIDGETS here, max $maxwidgets, max size $maxsize" >"$filepath"
    qReturnOk "$filepath" ; return 0
}


##############################################################################
# foobarMain -- main subroutine of foobar program
#       Can also be called from a larger program.
##############################################################################
foobarMain_Help='
Usage: [<option>...] [<positional parameter>]...
Options in any order:
    help|-help|--help   -- print this help message
'  # End of help message
foobarMain()
{
    qEnter "$@"  # our standard way to begin a function
    # Primary local variables:
    local result=''   # what we will return if successful

    # Options:
    local dohelp=n
    qOption 'help:dohelp=y,-help:dohelp=y,--help:dohelp=y,' "$@"
    shift $qresult
    if test $# -gt 0 ; then qReturnFail "Extra args: $@" ; return 1; fi

    # Help option
    if test "$dohelp" = y ; then
        printf "%s\n" "$foobarMain_Help" 
        qReturnOk ; return 0 ; fi

    # Here is some pretend useful code
    local filepath=''
    if ! qUserRead promptbase='ENTER OUTPUT FILEPATH (optional)' ; then
        qReturnFail ; return 1 ; fi
    qResult filepath
    if ! foobarWidgetsMake o="$filepath" ; then
        qReturnFail "It didnt work out!" ; return 1 ; fi
    qResult filepath
    quser "PRETENDED TO WRITE OUTPUT FILE $filepath"

    # Find the result 
    result="AN EXAMPLE, like $foobarConfigExample"

    # User verbosity is a matter of judgement... one of
    qbug  "We got $result"      # tell developer
    quser "We got $result"      # tell end user (tells developer too)
    qerror "We really failed: $result"   # tell all
    quser "I Was only kidding about that... all is good!"
    quser "Expect to see some output coming your way!"

    # All done OK! Return the result
    qReturnOk "$result" ; return 0
}



